alias Root.Console as console
alias Root.Time as time

const i32 W = 64
const i32 H = 20
const i32 FRAMES = 600

fun string esc() { $"{(char)27}" }

fun main() {
  // C64-ish palette as ANSI 256 colors (copper bars)
  arr<i32> bars = [17, 18, 19, 20, 21, 27, 33, 39, 45, 51, 45, 39, 33, 27, 21, 20, 19, 18, 17]

  string text = "    DFLAT RULES ... GREETINGS TO ALL C64 SCENERS ... NO GC, NO MERCY ...    "
  i32 len = (i32)text.len

  arr<i32> starX = arr<i32>[16]
  arr<i32> starY = arr<i32>[16]
  i32 s = 0
  while s < 16 {
    starX[s] = (i32)Root.Random.int(0, W - 1)
    starY[s] = (i32)Root.Random.int(0, H - 1)
    s += 1
  }

  console.print($"{esc()}[?25l")          // hide cursor
  i32 frame = 0
  while frame < FRAMES {
    console.print($"{esc()}[H")            // cursor home, no flicker
    i32 barTop = (i32)((Root.Math.sin(frame * 0.08) + 1.0) * (H - 6) / 2.0)
    i32 y = 0
    while y < H {
      string line = ""
      i32 x = 0
      while x < W {
        char c = ' '
        // stars
        s = 0
        while s < 16 {
          if starY[s] == y && starX[s] == x { c = s % 2 == 0 ? { '.', '*' } }
          s += 1
        }
        // sine scroller
        i32 ti = (x + frame / 2) % len
        i32 wave = (i32)((Root.Math.sin((x + frame) * 0.15) + 1.0) * 3.0) + H / 2 - 3
        if wave == y && text[ti] != ' ' { c = text[ti] }
        line = $"{line}{c}"
        x += 1
      }
      // copper bar color for this row
      i32 bi = y - barTop
      bool inBar = bi >= 0 && bi < 6
      i32 col = inBar ? { bars[(bi * 3 + frame / 4) % (i32)bars.len], 16 }
      console.print($"{esc()}[48;5;{col}m{esc()}[97m{line}{esc()}[0m\n")
      y += 1
    }
    time.sleep(30)
    frame += 1
    // scroll stars
    s = 0
    while s < 16 {
      starX[s] = (starX[s] + W - 1 - s % 3) % W
      s += 1
    }
  }
  console.print($"{esc()}[?25h{esc()}[0m")
} atEnd {
  console.log("Demo over. Press RESET.")
}
