// Racer for Dflat — stdlib 0.0.11
//
// A road seen from behind the car, as in the old arcade racers: the road bends left and right,
// the stripes on the sides and the trees pass by faster with the speed, mountains on the horizon.
// Leaving the road does not crash the car, it only slows it down.
//   w or ↑      accelerate
//   s or ↓      brake
//   a or ←      left
//   d or →      right
//   Esc or q    quit
//
// The console gives key presses, not keys held down: a key held repeats after a short pause, so the
// throttle stays on for a moment after each press to cover that pause.

namespace racer

alias Root.Console as console

const i32 WIDTH = 80
const i32 HEIGHT = 24
const i32 HORIZON = 8          // the first row of the road
const r64 VIEW = 200.0         // meters of road seen up to the horizon
const r64 FRAME = 0.05         // seconds of a frame (20 frames a second)

// The screen: a character, a text colour and a background colour for each cell. Printed row by row,
// changing the colours only where they change, so it is redrawn without clearing (no flicker)
class Screen {
  arr<char> cells = arr<char>[(uns)(WIDTH * HEIGHT)]
  arr<console.Color> fronts = arr<console.Color>[(uns)(WIDTH * HEIGHT)]
  arr<console.Color> backs = arr<console.Color>[(uns)(WIDTH * HEIGHT)]

  public fun put(i32 x, i32 y, char c, console.Color front, console.Color back) {
    if x < 0 || x >= WIDTH || y < 0 || y >= HEIGHT then return
    uns at = (uns)(y * WIDTH + x)
    cells[at] = c
    fronts[at] = front
    backs[at] = back
  }

  // a character over what is there: the background stays
  public fun over(i32 x, i32 y, char c, console.Color front) {
    if x < 0 || x >= WIDTH || y < 0 || y >= HEIGHT then return
    uns at = (uns)(y * WIDTH + x)
    cells[at] = c
    fronts[at] = front
  }

  public fun text(i32 x, i32 y, string words, console.Color front, console.Color back) {
    i32 column = x
    for char c in words {
      put(column, y, c, front, back)
      column++
    }
  }

  public fun show() {
    for i32 y in 0..HEIGHT {
      console.moveCursor(0, y)
      i32 x = 0
      while x < WIDTH {
        uns first = (uns)(y * WIDTH + x)
        console.Color front = fronts[first]
        console.Color back = backs[first]
        string run = ""
        while x < WIDTH {
          uns at = (uns)(y * WIDTH + x)
          if fronts[at] != front || backs[at] != back then break
          run += cells[at]
          x++
        }
        console.setColors(front, back)
        console.print(run)
      }
    }
  }
}

class Racer {
  Screen screen = Screen()

  r64 speed = 0.0             // km/h
  r64 distance = 0.0          // meters driven
  r64 carX = 0.0              // across the road: 0 the middle, -1 and 1 the edges
  r64 curve = 0.0             // the bend of the road now: negative left, positive right
  r64 curveTarget = 0.0       // the bend of the piece of road being driven
  r64 pieceLeft = 100.0       // meters to the next piece of road
  r64 skyShift = 0.0          // the mountains slide in the curves
  r64 nextTree = 60.0         // the distance of the next tree to place
  vec<r64> trees = vec<r64>() // the trees ahead, by distance; a negative distance is a tree on the left
  i64 frame = 0
  i64 throttleUntil = -1
  i64 brakeUntil = -1
  i64 steerUntil = -1
  r64 steer = 0.0
  bool quit = false

  // the shape of the mountains, repeated along the horizon
  string mountains = "      /\\            /\\/\\        ___/\\        /\\          /\\__/\\     /\\           "

  public fun bool running() { !quit }

  public fun r64 km() { distance / 1000.0 }

  public fun keys() {
    char? key = console.readKey()
    while key != null {
      char k = (key ?? ' ').toLower()
      if k == 'w' || k == console.KEY_UP {
        throttleUntil = frame + 12
        brakeUntil = -1
      } else if k == 's' || k == console.KEY_DOWN {
        brakeUntil = frame + 6
        throttleUntil = -1
      } else if k == 'a' || k == console.KEY_LEFT {
        steer = -1.0
        steerUntil = frame + 3
        carX -= 0.04
      } else if k == 'd' || k == console.KEY_RIGHT {
        steer = 1.0
        steerUntil = frame + 3
        carX += 0.04
      } else if k == 'q' || k == console.KEY_ESC {
        quit = true
      }
      key = console.readKey()
    }
  }

  public fun move() {
    frame++
    bool offRoad = carX < -1.1 || carX > 1.1
    if frame < throttleUntil {
      speed += 3.0
    } else if frame < brakeUntil {
      speed -= 9.0
    } else {
      speed -= 0.6
    }
    if offRoad && speed > 60.0 {
      speed -= 7.0   // the grass slows the car down quickly
    }
    speed = Root.Math.max(0.0, Root.Math.min(speed, 290.0))

    r64 meters = speed / 3.6 * FRAME
    distance += meters

    // steering works when the car moves; the curves push it outwards, more at high speed
    if frame < steerUntil {
      carX += steer * 0.05 * Root.Math.min(1.0, speed / 60.0)
    }
    carX -= curve * (speed / 290.0) * (speed / 290.0) * meters * 0.012
    carX = Root.Math.max(-2.6, Root.Math.min(carX, 2.6))

    // the road: a new piece now and then; the bend eases into the bend of the piece
    pieceLeft -= meters
    if pieceLeft <= 0.0 {
      r64 pick = Root.Random.real()
      curveTarget = pick < 0.35 ? { true: 0.0, false: (Root.Random.real() < 0.5 ? { true: -1.0, false: 1.0 }) * Root.Random.realRange(0.25, 1.0) }
      pieceLeft = Root.Random.realRange(150.0, 450.0)
    }
    curve += (curveTarget - curve) * Root.Math.min(1.0, meters * 0.012)
    skyShift += curve * meters * 0.08

    // the trees: placed ahead from time to time, gone once passed
    while nextTree < distance + VIEW {
      trees.add(Root.Random.real() < 0.5 ? { true: -nextTree, false: nextTree })
      nextTree += Root.Random.realRange(25.0, 120.0)
    }
    while trees.len > 0 && Root.Math.abs(trees[0]) < distance {
      trees.removeAt(0)
    }
  }

  // where the road is on a row: the middle and the half width, in columns
  fun r64 middleAt(r64 p) {
    r64 far = 1.0 - p
    r64 half = (0.05 + p * 0.42) * (r64)WIDTH
    return (r64)WIDTH * (0.5 + curve * far * far * far * 0.5) - carX * half
  }

  fun r64 halfAt(r64 p) { (0.05 + p * 0.42) * (r64)WIDTH }

  public fun draw() {
    drawSky()
    drawRoad()
    drawTrees()
    drawCar()
    drawPanel()
    screen.show()
  }

  fun drawSky() {
    i64 shift = (i64)skyShift
    i64 shape = (i64)mountains.len
    for i32 y in 1..HORIZON {
      for i32 x in 0..WIDTH {
        screen.put(x, y, ' ', console.Color.White, console.Color.Blue)
      }
    }
    // the mountains on the last rows of the sky
    for i32 x in 0..WIDTH {
      i64 at = ((i64)x + shift) % shape
      if at < 0 then at += shape
      char c = mountains[(uns)at]
      if c != ' ' {
        screen.put(x, HORIZON - 2, c, console.Color.White, console.Color.Blue)
        screen.put(x, HORIZON - 1, ' ', console.Color.Gray, console.Color.Gray)
      }
    }
  }

  fun drawRoad() {
    i32 rows = HEIGHT - HORIZON
    for i32 row in 0..rows {
      r64 p = (r64)(row + 1) / (r64)rows
      r64 far = 1.0 - p
      r64 middle = middleAt(p)
      r64 half = halfAt(p)
      r64 kerb = half * 0.12
      // the stripes move toward the car with the distance: closer together far away
      bool lightGrass = Root.Math.sin(20.0 * far * far * far + distance * 0.25) > 0.0
      bool redKerb = Root.Math.sin(60.0 * far * far + distance * 0.5) > 0.0
      bool line = Root.Math.sin(40.0 * far * far + distance * 0.5) > 0.0
      console.Color grass = lightGrass ? { true: console.Color.BrightGreen, false: console.Color.Green }
      console.Color kerbColour = redKerb ? { true: console.Color.Red, false: console.Color.BrightWhite }
      i32 y = HORIZON + row
      for i32 x in 0..WIDTH {
        r64 at = (r64)x + 0.5
        if at < middle - half - kerb || at > middle + half + kerb {
          screen.put(x, y, ' ', console.Color.Black, grass)
        } else if at < middle - half || at > middle + half {
          screen.put(x, y, ' ', console.Color.Black, kerbColour)
        } else if line && Root.Math.abs(at - middle) < 0.5 + p * 0.5 {
          screen.put(x, y, ' ', console.Color.Black, console.Color.BrightWhite)
        } else {
          screen.put(x, y, ' ', console.Color.White, console.Color.Black)
        }
      }
    }
  }

  fun drawTrees() {
    i32 rows = HEIGHT - HORIZON
    for r64 tree in trees {
      r64 ahead = Root.Math.abs(tree) - distance
      if ahead <= 0.0 || ahead >= VIEW then continue
      // the same perspective as the stripes: (1 - p)^3 grows with the distance
      r64 p = 1.0 - Root.Math.cbrt(ahead / VIEW)
      i32 row = (i32)(p * (r64)rows) - 1
      if row < 0 then continue
      r64 side = tree < 0.0 ? { true: -1.0, false: 1.0 }
      r64 x = middleAt(p) + side * (halfAt(p) * 1.12 + 3.0 + p * 12.0)
      i32 column = (i32)x
      i32 y = HORIZON + row
      screen.over(column, y, '♣', console.Color.Black)
      if p > 0.5 {
        screen.over(column - 1, y, '♣', console.Color.Black)
        screen.over(column + 1, y, '♣', console.Color.Black)
        screen.over(column, y + 1, '║', console.Color.Yellow)
      }
    }
  }

  fun drawCar() {
    i32 x = WIDTH / 2 - 4
    i32 lean = frame < steerUntil ? { true: (i32)steer, false: 0 }
    screen.text(x + lean, HEIGHT - 3, " _.-^-._ ", console.Color.BrightRed, console.Color.Black)
    screen.text(x, HEIGHT - 2, "[|=====|]", console.Color.BrightRed, console.Color.Black)
    screen.text(x, HEIGHT - 1, " O     O ", console.Color.Gray, console.Color.Black)
  }

  fun drawPanel() {
    for i32 x in 0..WIDTH {
      screen.put(x, 0, ' ', console.Color.BrightWhite, console.Color.Black)
    }
    string kmh = ((i64)speed).toStr().padLeft(3)
    string driven = $"{km():D02}"
    screen.text(2, 0, $"SPEED {kmh} km/h", console.Color.BrightYellow, console.Color.Black)
    screen.text(24, 0, $"DISTANCE {driven} km", console.Color.BrightWhite, console.Color.Black)
    if carX < -1.1 || carX > 1.1 {
      screen.text(48, 0, "OFF ROAD", console.Color.BrightRed, console.Color.Black)
    }
    screen.text(62, 0, "W/S A/D  Esc", console.Color.Gray, console.Color.Black)
  }
}

fun int main() {
  Racer game = Racer()
  console.clear()
  while game.running() {
    game.keys()
    game.move()
    game.draw()
    Root.Time.sleep(50)
  }
  console.setColors(null, null)
  console.clear()
  console.log($"You drove {game.km():D02} km")
  return 0
}
