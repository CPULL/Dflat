u64 big = 0x1F
r64 half = 0.5
const i32 limit = 100

fun u64 fib(u64 n) {
  if n < 2 {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}

fun bool isPalindrome(string s) {
  u64 i = 0
  u64 j = s.length
  while i < j {
    j--
    if s[i] != s[j] {
      return false
    }
    i++
  }
  return true
}

fun i32, string getUser() {
  return 1, "john"
}

fun (i32 val, string name) getPair() {
  return (1, "name")
}

fun hello(string name = "john doe", i32 age) {
