// Program entry and arguments (spec 14.1, 17.1)
import Root

fun int main(string args...) {
  arr<string> same = getArgs()
  Console.log(args.len == same.len)
  Console.log(args == same)
  Console.log(args.len)
  i32 count = (i32)args.len
  for i32 index = 1..count {
    Console.log($"arg {index}: {args[index]}")
  }
  Console.log(args[0].contains("args"))
  return count
}
