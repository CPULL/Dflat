// The array leaks closed on 2026-11-02 (spec 6.8.1, point 20): tuples inside tuples own their arrays; x, n = f() into an owner ends its old
// array; a local array assigned a borrowed one (a = b) ends its own array and from then on only borrows; a view used at once (len, for,
// an index, a copy) does not stop the array from ending with its scope; a new tuple that nothing keeps (f().0, g(f()), f() alone) ends
// its arrays with the statement
alias Root as r
public class Dog(string name) {
  public string name
} atEnd {
  r.Console.log("  end " + name)
}
public class Box {
  public arr<Dog> dogs = [Dog("f0")]
}
fun ((arr<Dog>, i32), i32) nested() {
  return (([Dog("n1")], 1), 2)
}
fun ->arr<Dog>, i32 pair(string n) {
  return [Dog(n)], 1
}
fun (arr<Dog>, i32) tup(string n) {
  return ([Dog(n)], 1)
}
fun uns count((arr<Dog>, i32) t) {
  return t.0.len
}
fun ->arr<Dog> fresh() {
  return [Dog("r1")]
}
fun nestedTuples() {
  ((arr<Dog>, i32), i32) t = (([Dog("a")], 1), 2)
  var u = nested()
  t = (([Dog("b")], 1), 3)
  r.Console.log("  end of nestedTuples")
}
fun multiTargets() {
  arr<Dog> x = [Dog("old")]
  i32 n = 0
  x, n = pair("p1")
  x, n = pair("p2")
  Box b = Box()
  b.dogs, n = pair("f1")
  r.Console.log("  end of multiTargets")
}
fun borrowed(bool flip) {
  arr<Dog> b = [Dog("b")]
  arr<Dog> a = [Dog("a1")]
  a = b
  r.Console.log($"  a is {a[0].name}")
  a = [Dog("a2")]
  if (flip) {
    a = b
  }
  r.Console.log("  end of borrowed")
}
fun views() {
  arr<Dog> a = [Dog("v1"), Dog("v2"), Dog("v3")]
  r.Console.log($"  view {a[0..2].len} {a[1..3][0].name}")
  for d in a[1..3] {
    r.Console.log("  " + d.name)
  }
  r.Console.log("  end of views")
}
fun temporaries() {
  r.Console.log($"  len {tup("t1").0.len}")
  r.Console.log($"  count {count(tup("t2"))}")
  tup("t3")
  pair("t4")
  fresh()
  r.Console.log("  end of temporaries")
}
r.Console.log("nestedTuples")
nestedTuples()
r.Console.log("multiTargets")
multiTargets()
r.Console.log("borrowed true")
borrowed(true)
r.Console.log("borrowed false")
borrowed(false)
r.Console.log("views")
views()
r.Console.log("temporaries")
temporaries()
r.Console.log("done")
