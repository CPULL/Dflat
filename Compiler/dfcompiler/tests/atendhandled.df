// What an atEnd block may do: handle its own exceptions with a catch inside the block; a silent exception that nothing inside the block
// handles does nothing (the block has no error part)
import Root

public class Notice(string text) : Exception, SilentException { }

fun i32 divide(i32 a, i32 b) { a / b }

fun cleanup() {
  Console.log("start")
  atEnd {
    i32 value = divide(1, 0)
    Console.log("not printed: the catch below ends the block")
    catch DivisionByZeroException { Console.log("handled inside the atEnd block") }
  }
  atEnd {
    throw Notice("silent in atEnd")
    Console.log("not printed: the throw is caught below")
    catch Notice n { Console.log("caught inside atEnd: " + n.message) }
  }
  atEnd {
    throw Notice("ignored")
    Console.log("printed: a silent throw nobody handles does nothing")
  }
  Console.log("end of body")
}
cleanup()
Console.log("after cleanup")
