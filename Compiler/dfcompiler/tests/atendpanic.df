// An exception that is not silent and is not handled inside an atEnd block is a Panic, even when nothing else is propagating (spec 15.7.6)
import Root

fun work() {
  Console.log("working")
  atEnd {
    Console.log("cleaning up")
    throw Exception("failed while cleaning up")
  }
  Console.log("work done")
}

work()
Console.log("never printed")
