namespace basics
import Root

fun u64 fib(u64 n) {
  if n < 2 then return n
  return fib(n - 1) + fib(n - 2)
}

fun i32 square(i32 x) { x * x }

fun greet(string name = "world") {
  Console.log($"Hello {name}!")
}

greet()
greet("Dflat")

// loops and recursion
for u64 i = 0..10 {
  Console.log($"fib({i}) = {fib(i)}")
}

i32 total = 0
for i32 i = 1..=100 step i += 1 {
  total += i
}
Console.log("sum 1..100 = " + total)

i32 count = 0
while count < 3 {
  count++
}
{
  count--
} while count > 1
Console.log($"count = {count}")

// casts and transmutes
i16 big16 = 257
Console.log($"(i8)257 = {(i8)big16}, [i8]257 = {[i8]big16}")
r64 huge = 1e300
Console.log($"(i32)1e300 = {(i32)huge}")

// numbers and strings
r64 x = 2
Console.log($"sqrt(2) = {Math.sqrt(x)}")
Console.log($"pi = {Math.PI}, lerp = {Math.lerp(0, 10, 0.25)}")
Console.log(1 + 2 + "a")
Console.log('a' + 'b')
Console.log($"square(12) = {square(12)}")
char smile = '\u{1F600}'
Console.log("smile " + smile)
string word = "héllo"
Console.log($"{word} has {word.len} chars and {word.sizeof} bytes")
Console.log($"literal braces: \{ok\}")

bool flag = true
if flag && total > 5000 {
  Console.log("big total")
} else if total > 100 {
  Console.log("medium total")
} else {
  Console.log("small total")
}

// labels and break
for i32 a = 0..5 {
  for i32 b = 0..5 {
    if a * b == 6 then break Found
  }
}
#Found#
Console.log("found a * b == 6")

// errors
i32 zero = 0
Console.log("dividing by zero...")
i32 boom = 10 / zero
Console.log($"not reached {boom}")
