// bitfield methods (spec 3.1.1): a call whose result is used gives a new value, a single call alone changes the variable,
// a chain alone changes nothing; Flags? is a nullable bitfield (7.1)
import Root

bitfield8 Flags { One: 0, Two: 1, Three: 2 }

class Holder {
  public Flags state = Flags.None
}

fun show(Flags f) {
  Console.log($"lent: {f.set(Flags.Three)}, still {f}")
}

Flags f = Flags.None
Flags n = f.set(Flags.One)
Console.log($"{n} / {f}")                // One / None
f.set(Flags.Two)
Console.log(f)                           // Two
f.toggle(Flags.One | Flags.Two)
Console.log(f)                           // One
f.setAs(Flags.Three, true)
f.clear(Flags.One)
Console.log(f)                           // Three
f.set(Flags.One).clear(Flags.Three)        // a chain alone: nothing changes
Console.log(f)                           // Three
show(f)
Holder h = Holder()
h.state.set(Flags.Two)
Console.log(h.state)                     // Two
arr<Flags> all = [Flags.None, Flags.None]
all[1].set(Flags.One)
Console.log(all)
const Flags fixed = Flags.Two
Console.log(fixed.set(Flags.One))        // a new value from a const

Flags? maybe = null
Console.log(maybe)
maybe = Flags.One
Console.log(maybe ?? Flags.None)
Flags plain = maybe ?? Flags.None
Console.log(plain.isSet(Flags.One))
