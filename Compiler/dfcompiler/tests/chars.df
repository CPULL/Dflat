// Char functions (spec 4.1)
import Root

fun ->string describe(char c) {
  string s = ""
  if c.isLetter() then s += "letter "
  if c.isDigit() then s += "digit "
  if c.isLetterOrDigit() then s += "alnum "
  if c.isWhiteSpace() then s += "space "
  if c.isUpper() then s += "upper "
  if c.isLower() then s += "lower "
  if c.isHexDigit() then s += "hex "
  if c.isPunctuation() then s += "punct "
  if c.isSymbol() then s += "symbol "
  if c.isControl() then s += "control "
  if c.isAscii() then s += "ascii "
  return s.trim()
}

Console.log("a: " + describe('a'))
Console.log("Z: " + describe('Z'))
Console.log("7: " + describe('7'))
Console.log("f: " + describe('f'))
Console.log("g: " + describe('g'))
Console.log("space: " + describe(' '))
Console.log("!: " + describe('!'))
Console.log("+: " + describe('+'))
Console.log("$: " + describe('$'))
Console.log("tab: " + describe('\t'))
Console.log("é: " + describe('é'))
Console.log("Ω: " + describe('Ω'))
Console.log("٣: " + describe('٣'))
Console.log("€: " + describe('€'))
Console.log("nbsp: " + describe('\u{00A0}'))
Console.log("中: " + describe('中'))

Console.log('a'.toUpper())
Console.log('Q'.toLower())
Console.log('é'.toUpper())
Console.log('Σ'.toLower())
Console.log('1'.toUpper())
string word = "abc"
Console.log(word[0].toUpper())
