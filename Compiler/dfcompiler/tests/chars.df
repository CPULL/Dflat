// Char functions (spec 4.1)
alias Root as r

fun string describe(char c) {
  string s = ""
  if c.isLetter() then s += "letter "
  if c.isDigit() then s += "digit "
  if c.isLetterOrDigit() then s += "alnum "
  if c.isWhiteSpace() then s += "space "
  if c.isUpper() then s += "upper "
  if c.isLower() then s += "lower "
  if c.isHexDigit() then s += "hex "
  if c.isPunctuation() then s += "punct "
  if c.isSymbol() then s += "symbol "
  if c.isControl() then s += "control "
  if c.isAscii() then s += "ascii "
  return s.trim()
}

r.Console.log("a: " + describe('a'))
r.Console.log("Z: " + describe('Z'))
r.Console.log("7: " + describe('7'))
r.Console.log("f: " + describe('f'))
r.Console.log("g: " + describe('g'))
r.Console.log("space: " + describe(' '))
r.Console.log("!: " + describe('!'))
r.Console.log("+: " + describe('+'))
r.Console.log("$: " + describe('$'))
r.Console.log("tab: " + describe('\t'))
r.Console.log("é: " + describe('é'))
r.Console.log("Ω: " + describe('Ω'))
r.Console.log("٣: " + describe('٣'))
r.Console.log("€: " + describe('€'))
r.Console.log("nbsp: " + describe('\u{00A0}'))
r.Console.log("中: " + describe('中'))

r.Console.log('a'.toUpper())
r.Console.log('Q'.toLower())
r.Console.log('é'.toUpper())
r.Console.log('Σ'.toLower())
r.Console.log('1'.toUpper())
string word = "abc"
r.Console.log(word[0].toUpper())
