// Classes, phase 1: fields, primary constructor, methods, this, visibility, statics, ?.
import Root

public class Counter(i32 start, string label) {
  public i32 start                       // sets the visibility of the header parameter
  i32 increment = 2
  u64 doubled = 2 * 2
  public static i32 created = 0
  public static const i32 MAX = 100
  static string prefix = "counter-"

  public fun i32 Next() {
    start += increment
    return start
  }
  public fun ->string Name() { prefix + label }
  public fun i32 Twice() { Next() + Next() }
  public fun Reset(i32 value) {
    this.start = value
    created += 1
  }
  public fun u64 Doubled() { doubled }
  public static fun ->Counter Make(string label) { Counter(0, label) }
  fun i32 Hidden() { 42 }
  public fun i32 Reveal() { Hidden() }
}

public class Empty { }

public class Person(string name, i32 age) {
  public string name
  public i32 age
  public Person partner
  public r64 score
  public date born
  public arr<i32> marks
}

Counter c = Counter(10, "a")
Console.log(c.start)
Console.log(c.Next())
Console.log(c.Next())
Console.log(c.Name())
Console.log(c.Twice())
Console.log(c.Doubled())
c.Reset(100)
Console.log(c.start)
c.start = 7
Console.log(c.start)
c.start += 3
c.start++
Console.log(c.start)
Console.log(Counter.created)
Console.log(Counter.MAX)
Counter.created = 50
Console.log(Counter.created)
Counter made = Counter.Make("z")
Console.log(made.Name())
Console.log(made.Reveal())
Console.log(c == made)
Counter same = c
Console.log(c == same)
Console.log(c != made)

// objects are null until set
Counter none = null
Console.log(none == null)
Console.log(c == null)
Counter view = c
Console.log(view == null)

// zero values of the fields
Person p = Person("Ann", 30)
Console.log(p.name + " " + p.age)
Console.log(p.partner == null)
Console.log(p.score)
Console.log(p.born == null)
Console.log(p.marks == null)
p.partner = Person("Bob", 31)
Console.log(p.partner.name)
Console.log(p.partner.partner == null)
p.born = date("2020-01-02")
Console.log(p.born)
p.marks = [1, 2, 3]
Console.log(p.marks[2])

// null-safe access
Person nobody = null
Console.log(nobody?.name == null)
Console.log(p?.name)
Console.log(p.partner?.partner?.name == null)
Console.log(p.partner?.age)
Person nothing = null
Console.log(nothing?.age == null)

// null access raises NullPointerException
i32 caught = 0
Console.log(nobody.name)
catch NullPointerException ex {
  Console.log("caught: " + ex.message)
  caught += 1
}
nobody.age = 4
catch NullPointerException {
  caught += 1
}
Console.log(p.partner.partner.age)
catch NullPointerException {
  caught += 1
}
Console.log(caught)

// printing: first three fields, one level
Empty e = Empty()
Console.log(e)
Console.log(made)
Console.log(p)
Console.log(nobody)
Console.log($"p is {p.partner}")

// arrays, tuples and parameters of objects
arr<Person> people = [Person("A", 1), Person("B", 2)]
Console.log(people[1].name)
fun ->string describe(Person who) { who.name + ":" + who.age }
Console.log(describe(people[0]))
fun (Person who, i32 count) pair(Person x) { return (x, 2) }
Console.log(pair(p).count)
