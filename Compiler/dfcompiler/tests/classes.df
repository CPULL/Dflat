// Classes, phase 1: fields, primary constructor, methods, this, visibility, statics, ?.
alias Root as r

public class Counter(i32 start, string label) {
  public i32 start                       // sets the visibility of the header parameter
  i32 increment = 2
  u64 doubled = 2 * 2
  public static i32 created = 0
  public static const i32 MAX = 100
  static string prefix = "counter-"

  public fun i32 Next() {
    start += increment
    return start
  }
  public fun string Name() { prefix + label }
  public fun i32 Twice() { Next() + Next() }
  public fun Reset(i32 value) {
    this.start = value
    created += 1
  }
  public fun u64 Doubled() { doubled }
  public static fun Counter Make(string label) { Counter(0, label) }
  fun i32 Hidden() { 42 }
  public fun i32 Reveal() { Hidden() }
}

public class Empty { }

public class Person(string name, i32 age) {
  public string name
  public i32 age
  public Person partner
  public r64 score
  public date born
  public arr<i32> marks
}

Counter c = Counter(10, "a")
r.Console.Log(c.start)
r.Console.Log(c.Next())
r.Console.Log(c.Next())
r.Console.Log(c.Name())
r.Console.Log(c.Twice())
r.Console.Log(c.Doubled())
c.Reset(100)
r.Console.Log(c.start)
c.start = 7
r.Console.Log(c.start)
c.start += 3
c.start++
r.Console.Log(c.start)
r.Console.Log(Counter.created)
r.Console.Log(Counter.MAX)
Counter.created = 50
r.Console.Log(Counter.created)
Counter made = Counter.Make("z")
r.Console.Log(made.Name())
r.Console.Log(made.Reveal())
r.Console.Log(c == made)
Counter same = c
r.Console.Log(c == same)
r.Console.Log(c != made)

// objects are null until set
Counter none = null
r.Console.Log(none == null)
r.Console.Log(c == null)
Counter view = c
r.Console.Log(view == null)

// zero values of the fields
Person p = Person("Ann", 30)
r.Console.Log(p.name + " " + p.age)
r.Console.Log(p.partner == null)
r.Console.Log(p.score)
r.Console.Log(p.born == null)
r.Console.Log(p.marks == null)
p.partner = Person("Bob", 31)
r.Console.Log(p.partner.name)
r.Console.Log(p.partner.partner == null)
p.born = date("2020-01-02")
r.Console.Log(p.born)
p.marks = [1, 2, 3]
r.Console.Log(p.marks[2])

// null-safe access
Person nobody = null
r.Console.Log(nobody?.name == null)
r.Console.Log(p?.name)
r.Console.Log(p.partner?.partner?.name == null)
r.Console.Log(p.partner?.age)
Person nothing = null
r.Console.Log(nothing?.age == null)

// null access raises NullPointerException
i32 caught = 0
r.Console.Log(nobody.name)
catch NullPointerException ex {
  r.Console.Log("caught: " + ex.Message)
  caught += 1
}
nobody.age = 4
catch NullPointerException {
  caught += 1
}
r.Console.Log(p.partner.partner.age)
catch NullPointerException {
  caught += 1
}
r.Console.Log(caught)

// printing: first three fields, one level
Empty e = Empty()
r.Console.Log(e)
r.Console.Log(made)
r.Console.Log(p)
r.Console.Log(nobody)
r.Console.Log($"p is {p.partner}")

// arrays, tuples and parameters of objects
arr<Person> people = [Person("A", 1), Person("B", 2)]
r.Console.Log(people[1].name)
fun string describe(Person who) { who.name + ":" + who.age }
r.Console.Log(describe(people[0]))
fun (Person who, i32 count) pair(Person x) { return (x, 2) }
r.Console.Log(pair(p).count)
