// Classes with a main function; overloads, named arguments, defaults, statics calling statics
import Root

public class Box(i32 width, i32 height) {
  public i32 width
  public i32 height
  public static i32 made = 0
  public fun i32 Area() { width * height }
  public fun ->Box Grow(i32 by) { Box(width + by, height + by) }
  public fun ->Box Grow(i32 w, i32 h) { Box(width + w, height + h) }
  public fun ->string Show(string prefix = "box", i32 times = 1) { prefix + ":" + Area() * times }
  public static fun ->Box Unit() { made += 1; return Box(1, 1) }
  public static fun ->Box Two() { return Unit().Grow(1) }
  public static fun i32 Count() { made }
}

public class Wrapper {
  public Box box = Box.Unit()
  public fun i32 Area() { box.Area() }
}

fun int main(string args...) {
  Box b = Box(2, 3)
  Console.log(b.Area())
  Console.log(b.Grow(1).Area())
  Console.log(b.Grow(1, 2).Area())
  Console.log(b.Grow(w: 2, h: 0).Area())
  Console.log(b.Show())
  Console.log(b.Show("x"))
  Console.log(b.Show(times: 2))
  Console.log(b.Show(times: 3, prefix: "y"))
  Box t = Box.Two()
  Console.log(t.Area())
  Console.log(Box.Count())
  Wrapper w = Wrapper()
  Console.log(w.Area())
  Console.log(Box.made)
  Console.log(args.len)
  return 7
}
