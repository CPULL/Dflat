import Root
list<i32> l = [1, 2, 3]
l.clear()
Console.log(l.len)
l.add(4)
Console.log(l)
vec<i32> v = [1, 2, 3]
v.clear()
Console.log(v)
arr<i32> a = [5, 6]
a.clear()
Console.log(a)
list<string> words = ["a", "b"]
fun string clearWords(&list<string> words) {
  for string w in words { words.clear() }
  return "cleared"
  catch ModifyingIteratedCollectionException { return "list iterated" }
}
Console.log(clearWords(&words))
Console.log(words.len)
map<string, i32> m = ["a": 1, "b": 2]
fun string clearMap(&map<string, i32> m) {
  for (string k, i32 n) in m { m.clear() }
  return "cleared"
  catch ModifyingIteratedCollectionException { return "map iterated" }
}
Console.log(clearMap(&m))
m.clear()
Console.log(m.len)
hset<i32> s = [1, 2]
fun string clearSet(&hset<i32> s) {
  for i32 x in s { s.clear() }
  return "cleared"
  catch ModifyingIteratedCollectionException { return "set iterated" }
}
Console.log(clearSet(&s))
s.clear()
Console.log(s.len)
