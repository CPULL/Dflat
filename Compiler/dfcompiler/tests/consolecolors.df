// Console.setColors and Console.Color (stdlib 2). The test runs without a console: setColors does nothing, the output stays plain
namespace consolecolors
import Root


Console.setColors(Console.Color.Yellow, Console.Color.Black)
Console.log("yellow on black")
Console.Color? back = null
Console.setColors(Console.Color.BrightWhite, back)
back = Console.Color.Blue
Console.setColors(null, back)
Console.Color c = Console.Color.BrightCyan
Console.log(c)
Console.log(Console.Color.Gray)
Console.setColors(null, null)
Console.log("default")
