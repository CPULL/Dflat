// Console.readKey, the KEY_ constants and Console.moveCursor (stdlib 2). The test runs without a console: readKey reads the
// input like read (null at its end) and moveCursor does nothing
namespace consolekeys
import Root

Console.log([u32]Console.KEY_LEFT)
Console.log([u32]Console.KEY_UP)
Console.log([u32]Console.KEY_RIGHT)
Console.log([u32]Console.KEY_DOWN)
Console.log($"{[u32]Console.KEY_ENTER} {[u32]Console.KEY_ESC} {[u32]Console.KEY_BACKSPACE} {[u32]Console.KEY_TAB}")
Console.log(Console.KEY_LEFT)
char? key = Console.readKey()
if key == '\u{FEFF}' then key = Console.readKey()    // the test runner may start the input with a byte order mark
Console.log(key == null)
Console.log(key == Console.KEY_LEFT)
i32 x = 3
if key == Console.KEY_LEFT then x--
Console.moveCursor(x, 2)
Console.log(x)
