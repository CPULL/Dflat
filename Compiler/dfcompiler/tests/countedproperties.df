// Counted properties (spec 11.1.4): R: gives a usage, W: takes one (k.boss = @rex), a read in an expression takes a usage for the statement
namespace countedproperties
import Root
class Dog(string name) {
  public string name
} atEnd {
  Console.log($"{name} ends")
}
class Kennel {
  public @Dog boss {
    R: { field }
    W: { Console.log($"new boss {value.name}"); field = value }
  } = Dog("Rex")
  public @i32 visits { R: { field } W: { field = value } }
}
fun f() {
  Kennel k = Kennel()
  Console.log($"boss {k.boss.name}")
  @Dog b = k.boss
  Console.log($"users {b.usersCount}")
  @Dog max = Dog("Max")
  k.boss = @max
  Console.log($"users of max {max.usersCount}, b is still {b.name}")
  k.visits = 3
  @i32 v = k.visits
  Console.log($"visits {k.visits} {v}")
}
fun keep(@Dog d) { Console.log($"keep {d.name}, users {d.usersCount}") }
fun g() {
  Kennel k = Kennel()
  keep(@k.boss)
}
f()
g()
