// date and time formatting (spec 8.4)
alias Root as r

date d = date("2026-03-05T14:07:09.045Z")
r.Console.log(d.toStr())
r.Console.log(d.toStr("yyyy-MM-dd"))
r.Console.log(d.toStr("yy/M/d"))
r.Console.log(d.toStr("dddd, d MMMM yyyy"))
r.Console.log(d.toStr("ddd dd MMM"))
r.Console.log(d.toStr("HH:mm:ss.fff"))
r.Console.log(d.toStr("h:mm tt, H k"))
r.Console.log(d.toStr("h:mm t"))
r.Console.log(d.toStr("s.f ss.ff .F FFF"))
r.Console.log(date("2026-03-05T14:07:09.500Z").toStr("s.F|s.FF|s.FFF"))
r.Console.log(d.toStr("yyyy-MM-dd'T'HH:mm:ss.fffz"))
r.Console.log(d.toStr("zzz zz"))
r.Console.log(d.toStr("g"))
r.Console.log(d.toStr("'literal' \"also\" \\q"))
r.Console.log(d.toStr("w ww q i ii r e ee j"))
r.Console.log(date("2021-01-03").toStr("i r") + "|" + date("2020-12-31").toStr("i r") + "|" + date("2018-12-31").toStr("i r"))
r.Console.log("[" + d.toStr("yyyy a>14") + "]")
r.Console.log("[" + d.toStr("yyyy a<14") + "]")
r.Console.log("[" + d.toStr("yyyy a^14") + "]")
r.Console.log($"{d:yyyy-MM-dd} and {d:HH:mm}")
date none = null
r.Console.log(none.toStr("yyyy"))
r.Console.log($"{none:yyyy}")

time t = time("07:08:09.010")
r.Console.log(t.toStr())
r.Console.log(t.toStr("HH:mm:ss.fff"))
r.Console.log(t.toStr("h:mm:ss tt"))
r.Console.log($"{t:H.m.s}")
time notime = null
r.Console.log(notime.toStr("HH"))
r.Console.log(time("23:59").toStr("hh tt k"))
r.Console.log(time("00:30").toStr("hh tt k"))
