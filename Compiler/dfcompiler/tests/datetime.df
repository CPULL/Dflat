// date and time members (spec 3.3)
alias Root as r

date d = date("2026-10-11T14:03:22.123Z")
r.Console.Log(d)
r.Console.Log($"{d.year}-{d.month}-{d.day} {d.hour}:{d.minute}:{d.second}.{d.millisecond}")
r.Console.Log(d.dayOfWeek)
r.Console.Log(d.dayOfWeek == DayOfWeek.Sunday)
r.Console.Log(d.dayOfYear)
r.Console.Log(d.timeOfDay)
r.Console.Log(d.unixMilliseconds)

// constructors
r.Console.Log(date(0))
r.Console.Log(date(86400000))
r.Console.Log(date.fromUnixTime(1760191402123))
r.Console.Log(date("2020-02-29"))
r.Console.Log(date("2020/02/29 10:30"))
r.Console.Log(date("2020-02-29 10:30:15"))
r.Console.Log(date("2020-02-29T10:30:15+02:00"))
r.Console.Log(date("2020-02-29T10:30:15-05:30"))
r.Console.Log(date("2020-02-29T10:30:15.5Z"))
r.Console.Log(date("  2020-02-29  "))
r.Console.Log(date("2021-02-29") == null)
r.Console.Log(date("hello") == null)
r.Console.Log(date("2020-13-01") == null)
r.Console.Log(date("2020-01-01T25:00") == null)
r.Console.Log(date("") == null)

// add...
date start = date("2024-01-31T10:00:00Z")
r.Console.Log(start.addDays(1))
r.Console.Log(start.addDays(-31))
r.Console.Log(start.addMonths(1))
r.Console.Log(start.addMonths(13))
r.Console.Log(start.addMonths(-2))
r.Console.Log(start.addYears(1))
r.Console.Log(date("2024-02-29").addYears(1))
r.Console.Log(date("2024-02-29").addYears(-4))
r.Console.Log(start.addHours(15))
r.Console.Log(start.addMinutes(90))
r.Console.Log(start.addSeconds(3600))
r.Console.Log(start.addMilliseconds(1500))
r.Console.Log(start.startOfDay())
r.Console.Log(date(-1).startOfDay())
r.Console.Log(date(-1))
r.Console.Log(date(-86400000 * 366).year)
date nothing = null
r.Console.Log(nothing.addDays(3) == null)
r.Console.Log(nothing.year)

// differences
lapse span = date("2024-01-02") - date("2024-01-01")
r.Console.Log(span)

// time
time t = time("14:30")
r.Console.Log(t)
r.Console.Log($"{t.hour}:{t.minute}:{t.second}.{t.millisecond} total {t.totalMilliseconds}")
r.Console.Log(time("14:30:15.250"))
r.Console.Log(time("2:05 pm"))
r.Console.Log(time("12 am"))
r.Console.Log(time("12:00 PM"))
r.Console.Log(time("11:59:59pm"))
r.Console.Log(time("7"))
r.Console.Log(time(3600000))
r.Console.Log(time("25:00") == null)
r.Console.Log(time("13:00 pm") == null)
r.Console.Log(time(86400000) == null)
r.Console.Log(time(-5) == null)
r.Console.Log(t.addHours(10))
r.Console.Log(t.addMinutes(-31))
r.Console.Log(t.addSeconds(86400 + 5))
r.Console.Log(t.addMilliseconds(1))
r.Console.Log(t.addHours(-100))
r.Console.Log(time("10:00") < time("11:00"))
r.Console.Log(time("10:00") == time(36000000))
time notime = null
r.Console.Log(notime < t)
r.Console.Log(notime)
r.Console.Log(time("10:00") - time("08:30"))
r.Console.Log(date("2024-01-01") + time("08:30"))
r.Console.Log(date("2024-01-01") - time("08:30"))
r.Console.Log(date("2024-01-01") + notime == null)
time parsed = time.parse("9:15 am")
r.Console.Log(parsed)
r.Console.Log(time.parse("junk") == null)
r.Console.Log(time.parse("junk", time("01:00")))
r.Console.Log(time.parse("09.15", "HH.mm"))
r.Console.Log(date.parse("2024-05-06"))
r.Console.Log(date.parse("nope", date(0)))
r.Console.Log(date.parse("06/05/2024 10:20", "dd/MM/yyyy HH:mm"))
r.Console.Log(date.parse("6 May 2024", "d MMM yyyy"))
r.Console.Log(date.parse("Monday, May 06, 2024", "dddd, MMMM dd, yyyy"))
r.Console.Log(date.parse("2024-05-06T10:20:30+0200", "yyyy-MM-dd'T'HH:mm:ssz") == null)
r.Console.Log(date.parse("2024-05-06 10:20:30 +02:00", "yyyy-MM-dd HH:mm:ss zzz"))
r.Console.Log(date.parse("2024-05-06 10:20 PM", "yyyy-MM-dd hh:mm tt"))
r.Console.Log(date.parse("2024-05-06", "yyyy-MM-dd HH"))
r.Console.Log(date.parse("99-05-06", "yy-MM-dd"))
r.Console.Log(date.parse("24-05-06", "yy-MM-dd"))
r.Console.Log(date.parse("2024-05-06 10:20:30.123456", "yyyy-MM-dd HH:mm:ss.ffffff"))
