// date and time members (spec 3.3)
import Root

date d = date("2026-10-11T14:03:22.123Z")
Console.log(d)
Console.log($"{d.year}-{d.month}-{d.day} {d.hour}:{d.minute}:{d.second}.{d.millisecond}")
Console.log(d.dayOfWeek)
Console.log(d.dayOfWeek == DayOfWeek.Sunday)
Console.log(d.dayOfYear)
Console.log(d.timeOfDay)
Console.log(d.unixMilliseconds)

// constructors
Console.log(date(0))
Console.log(date(86400000))
Console.log(date.fromUnixTime(1760191402123))
Console.log(date("2020-02-29"))
Console.log(date("2020/02/29 10:30"))
Console.log(date("2020-02-29 10:30:15"))
Console.log(date("2020-02-29T10:30:15+02:00"))
Console.log(date("2020-02-29T10:30:15-05:30"))
Console.log(date("2020-02-29T10:30:15.5Z"))
Console.log(date("  2020-02-29  "))
Console.log(date("2021-02-29") == null)
Console.log(date("hello") == null)
Console.log(date("2020-13-01") == null)
Console.log(date("2020-01-01T25:00") == null)
Console.log(date("") == null)

// add...
date start = date("2024-01-31T10:00:00Z")
Console.log(start.addDays(1))
Console.log(start.addDays(-31))
Console.log(start.addMonths(1))
Console.log(start.addMonths(13))
Console.log(start.addMonths(-2))
Console.log(start.addYears(1))
Console.log(date("2024-02-29").addYears(1))
Console.log(date("2024-02-29").addYears(-4))
Console.log(start.addHours(15))
Console.log(start.addMinutes(90))
Console.log(start.addSeconds(3600))
Console.log(start.addMilliseconds(1500))
Console.log(start.startOfDay())
Console.log(date(-1).startOfDay())
Console.log(date(-1))
Console.log(date(-86400000 * 366).year)
date nothing = null
Console.log(nothing.addDays(3) == null)
Console.log(nothing.year)

// differences
lapse span = date("2024-01-02") - date("2024-01-01")
Console.log(span)

// time
time t = time("14:30")
Console.log(t)
Console.log($"{t.hour}:{t.minute}:{t.second}.{t.millisecond} total {t.totalMilliseconds}")
Console.log(time("14:30:15.250"))
Console.log(time("2:05 pm"))
Console.log(time("12 am"))
Console.log(time("12:00 PM"))
Console.log(time("11:59:59pm"))
Console.log(time("7"))
Console.log(time(3600000))
Console.log(time("25:00") == null)
Console.log(time("13:00 pm") == null)
Console.log(time(86400000) == null)
Console.log(time(-5) == null)
Console.log(t.addHours(10))
Console.log(t.addMinutes(-31))
Console.log(t.addSeconds(86400 + 5))
Console.log(t.addMilliseconds(1))
Console.log(t.addHours(-100))
Console.log(time("10:00") < time("11:00"))
Console.log(time("10:00") == time(36000000))
time notime = null
Console.log(notime < t)
Console.log(notime)
Console.log(time("10:00") - time("08:30"))
Console.log(date("2024-01-01") + time("08:30"))
Console.log(date("2024-01-01") - time("08:30"))
Console.log(date("2024-01-01") + notime == null)
time parsed = time.parse("9:15 am")
Console.log(parsed)
Console.log(time.parse("junk") == null)
Console.log(time.parse("junk", time("01:00")))
Console.log(time.parse("09.15", "HH.mm"))
Console.log(date.parse("2024-05-06"))
Console.log(date.parse("nope", date(0)))
Console.log(date.parse("06/05/2024 10:20", "dd/MM/yyyy HH:mm"))
Console.log(date.parse("6 May 2024", "d MMM yyyy"))
Console.log(date.parse("Monday, May 06, 2024", "dddd, MMMM dd, yyyy"))
Console.log(date.parse("2024-05-06T10:20:30+0200", "yyyy-MM-dd'T'HH:mm:ssz") == null)
Console.log(date.parse("2024-05-06 10:20:30 +02:00", "yyyy-MM-dd HH:mm:ss zzz"))
Console.log(date.parse("2024-05-06 10:20 PM", "yyyy-MM-dd hh:mm tt"))
Console.log(date.parse("2024-05-06", "yyyy-MM-dd HH"))
Console.log(date.parse("99-05-06", "yy-MM-dd"))
Console.log(date.parse("24-05-06", "yy-MM-dd"))
Console.log(date.parse("2024-05-06 10:20:30.123456", "yyyy-MM-dd HH:mm:ss.ffffff"))
