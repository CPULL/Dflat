// enforce, step 4 (spec 7.2.3): catch E on x takes only the exceptions generated by x (a call whose receiver is x); a catch without on takes
// the others. And a return inside the block runs every atEnd clause, the ones before the catches too (spec 7.2.4)
alias Root as r

public class Trouble(string text) : Exception { }

public class Part(string name) {
  public string name
  unrestricted fun work(bool fail) {
    if fail {
      throw Trouble(name + " failed")
    }
    r.Console.log("    " + name + " works")
  }
  unrestricted fun Part self() { this }
  unrestricted fun i32 value(i32 v) { v }
}

fun run(Part a, Part b, bool failA, bool failB) {
  enforce a, b {
    a.work(failA)
    b.work(failB)
  }
  catch Trouble ex on a { r.Console.log("  from a: " + ex.message) }
  catch Trouble ex on b { r.Console.log("  from b: " + ex.message) }
}

fun nested(Part a, Part b) {
  enforce a, b {
    a.value(b.value(1))                  // b's call ends before a's: a raising would be a's
    b.work(true)
  }
  catch Trouble on a { r.Console.log("  wrong: a") }
  catch Trouble on b { r.Console.log("  right: b") }
}

fun throughMember(Part a, Part b) {
  enforce a, b {
    a.self().work(true)                  // the receiver chain starts at a
  }
  catch Trouble on b { r.Console.log("  wrong: b") }
  catch Trouble on a { r.Console.log("  right: a") }
}

fun others(Part a) {
  Part loose = Part("loose")
  enforce a {
    loose.work(true)                     // not a variable of the enforce
  }
  catch Trouble on a { r.Console.log("  wrong: a") }
  catch Trouble ex { r.Console.log("  not on a: " + ex.message) }
}

fun i32 early(i32? value) {
  enforce value {
    return value * 3
  }
  atEnd { r.Console.log("  success atEnd 1") }
  catch Trouble { }
  atEnd { r.Console.log("  success atEnd 2") }
  catch all { }
  atEnd { r.Console.log("  finally") }
  return 0
}

fun i32 earlyRaise(i32? value) {
  enforce value {
    Part("p").work(true)
    return value
  }
  atEnd { r.Console.log("  wrong: success atEnd") }
  catch Trouble { r.Console.log("  caught") }
  atEnd { r.Console.log("  finally") }
  return -1
}

Part a = Part("a")
Part b = Part("b")
r.Console.log("a fails")
run(a, b, true, false)
r.Console.log("b fails")
run(a, b, false, true)
r.Console.log("nested calls")
nested(a, b)
r.Console.log("through a member")
throughMember(a, b)
r.Console.log("other objects")
others(a)
r.Console.log("return")
r.Console.log($"  {early(5)}")
r.Console.log("raise before the return")
r.Console.log($"  {earlyRaise(5)}")
r.Console.log("done")
