// += and -= on the set or the map of an entry (spec 6.6, F9): h[k] += x is h[k].add(x); a missing key reads null
import Root
fun go() {
  hmap<i32, set<string>> h = hmap<i32, set<string>>()
  h[1] = set<string>()
  h[1] += "x"
  h[1] += "y"
  h[1] -= "x"
  map<string, map<string, i32>> m = map<string, map<string, i32>>()
  m["a"] = map<string, i32>()
  m["a"] += ("k", 3)
  m["a"] += ("j", 4)
  m["a"] -= "k"
  vec<set<i32>> v = [set<i32>()]
  v[0] += 5
  Console.log($"{h} {m} {v}")
  h[2] += "z"
  catch NullPointerException {
    Console.log("missing key: null")
  }
}
go()
