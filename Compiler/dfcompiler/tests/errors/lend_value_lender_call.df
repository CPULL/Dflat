namespace lend_value_lender_call
alias Root as r
class Board {
  public i32 score
  public string title = "board"
  public fun &i32 scoreRef() { score }
  public fun &string titleRef() { title }
  public fun reset() { score = 0 }
}
fun f() {
  Board board = Board()
  &i32 s = board.scoreRef()
  board.reset()
  s += 1
}
f()
