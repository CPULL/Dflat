// Top-level const (spec 1.5): set at program start, seen by every function and method;
// a list literal in a for loop takes the type of the loop variable
namespace globalconsts
import Root

const i32 WIDTH = 10
const i32 AREA = WIDTH * 2
const string TITLE = "tetris"
const arr<i32> KICKS = [0, -1, 1]

class Board {
  public static i32 cells = AREA + 1        // a static reads a const: the consts are set first
  public fun i32 doubled() { WIDTH * 2 }
}

fun i32 total() { WIDTH + AREA + KICKS[1] }

Console.log(Board().doubled())
Console.log(total())
Console.log(Board.cells)
Console.log(TITLE.toUpper())
Console.log($"{TITLE} {KICKS.len}")

for i32 k in [0, -1, 1] { Console.print($"{k} ") }
Console.log("")
for var s in ["a", "b"] { Console.print(s) }
Console.log("")
for r64 x in [1, 2.5] { Console.print($"{x} ") }
Console.log("")
