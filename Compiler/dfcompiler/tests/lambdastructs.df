// Function values in struct fields (spec 13.3.3): a struct copy copies them with !, a replaced one ends, an unassigned one raises UnassignedFunctionCallException
import Root
public class Dog(string name) {
  public string name
} atEnd {
  Console.log("  end " + name)
}
struct Button {
  string label,
  fun(i32) onClick
}
fun ->fun(i32) handler(string n) {
  Dog d = Dog(n)
  return (i32 x; ->d) { Console.log($"  {d.name} clicked {x}") }
}
fun main() {
  Button b = Button(label: "ok", onClick: handler("h1"))
  b.onClick(1)
  Button c = b
  c.onClick(2)
  b.onClick = handler("h2")
  b.onClick(3)
  c.onClick(4)
  Button e = Button(label: "none")
  e.onClick(5)
  catch UnassignedFunctionCallException { Console.log("  unassigned") }
  Console.log("end of main")
}
