// &s and &a of strings and arrays in a lambda (spec 13.3.1): the lambda can change and replace them, as a & parameter can; also &field in a method
alias Root as r
public class Dog(string name) {
  public string name
} atEnd {
  r.Console.log("  end " + name)
}
public class Box {
  string label = "box"
  public fun relabel() {
    fun() f = (; &label) { label = label + "!" }
    f()
    f()
    r.Console.log("  " + label)
  }
}
fun strings() {
  string s = "ab"
  fun() grow = (; &s) {
    s += "c"
  }
  grow()
  grow()
  r.Console.log("  " + s)
  string lit = "x"
  fun() swap = (; &lit) { lit = "new " + lit }
  swap()
  r.Console.log("  " + lit)
}
fun arrays() {
  arr<Dog> a = [Dog("a1")]
  fun() replace = (; &a) {
    a[0].name = "a1b"
    a = [Dog("a2"), Dog("a3")]
  }
  replace()
  r.Console.log($"  {a.len} {a[0].name}")
  arr<i32> n = [1, 2]
  fun() bump = (; &n) { n[0] += 10 }
  bump()
  r.Console.log($"  {n[0]}")
  r.Console.log("  end of arrays")
}
fun main() {
  r.Console.log("strings"); strings()
  r.Console.log("arrays"); arrays()
  r.Console.log("fields"); Box().relabel()
}
