// static properties (spec 11.1.4, 11.1.2), ??= on a property (7.1), m.add(->other) and s.add(->other) (6.6)
import Root
alias Root.Console as c

class Counter {
  public static i32 count { R: { field * 2 } W: { field = value + 1 } }
  public static fun i32 twice() { count * 2 }
  public static fun bump() { count += 10 }
}

class Box {
  i32 writes
  public i32? level { R: { field } W: { writes += 1; field = value } }
  public fun i32 written() { writes }
}

Counter.count = 3
c.log(Counter.count)                       // 8: W: stores 4, R: gives 8
Counter.bump()
c.log($"{Counter.count} {Counter.twice()}")
Counter.count++
c.log(Counter.count)

Box b = Box()
b.level ??= 5                                      // null: the setter runs
b.level ??= 9                                      // not null: the setter does not run
Console.log($"{b.level} {b.written()}")

map<string, i32> a = ["x": 1]
map<string, i32> other = ["y": 2]
a.add(->other)
Console.log($"{a} {other == null}")
map<string, i32> more = ["z": 3]
a += ->more
Console.log($"{a} {more == null}")
set<i32> s = [1]
set<i32> t = [2, 3]
s.add(->t)
Console.log($"{s} {t == null}")
