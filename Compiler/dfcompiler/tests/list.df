// Lists list<T> (spec 6.8.3): a singly linked list
import Root

public class Dog(string name) {
  public string name
}

list<i32> numbers = [1, 2, 3]
numbers.add(4)
numbers.insert(0, 9)
numbers.insert(2, 7)
numbers.insert(numbers.len, 8)
Console.log(numbers)
Console.log(numbers.len)
Console.log(numbers[2])
numbers[2] = 50
numbers[0] += 1
Console.log(numbers)

// a bare list takes its type from the literal
list words = ["pear", "apple", "fig"]
list<string> empty = []
Console.log(words)
Console.log($"{empty.len} {empty}")

// searching, ordering and changing
Console.log(words.has("fig"))
Console.log(words.has("kiwi"))
Console.log(words.indexOf("apple"))
words.sort()
Console.log(words)
words.sort(SortDirection.DESC)
Console.log(words)
words.reverse()
Console.log(words)
Console.log(words[0])

// removing
list<i32> work = [5, 6, 5, 7, 5, 8]
Console.log(work.remove(7))
Console.log(work.remove(99))
Console.log(work.removeAll(5))
Console.log(work)
work.removeAt(0)
Console.log(work)
work.removeAt(0)
Console.log($"{work.len} {work}")
work.add(1)
work.add(2)
work.removeAt(1)
work.add(3)
Console.log(work)
work.clear()                       // all the items go, as truncate(0) (spec 6.6)
Console.log($"{work.len} {work}")
work.truncate(0)
Console.log($"{work.len} {work}")

// fill: every item, or count new items
list<i32> filled = [1, 2, 3]
filled.fill(0)
filled.fill(2, 7)
Console.log(filled)

// swap exchanges two positions; replace puts a new item and gives back the old one
list<string> letters = ["x", "y", "z"]
letters.swap(0, 2)
Console.log(letters)
string was = letters.replace(1, "Y")
Console.log($"{was} {letters}")

// ->list[i] takes the item out of the list
list<string> queue = ["a", "b", "c"]
string firstOut = ->queue[0]
string lastOut = ->queue[1]
Console.log($"{firstOut} {lastOut} {queue}")

// objects
list<Dog> kennel = [Dog("rex"), Dog("fido")]
kennel.add(Dog("luna"))
Console.log(kennel[2].name)
for Dog dog in kennel {
  Console.print(dog.name + ";")
}
Console.log("")
Console.log(kennel[1].name)

// the iterator by hand: it keeps the list from changing its size until it ends (spec 6.4), here at the end of the function
fun byHand(list<i32> source) {
  var iterator = source.getIterator()
  var first = iterator.next()
  var second = iterator.next()
  Console.log($"{first.value} {first.isValid} {second.value} {second.isValid}")
}
byHand(numbers)

// an index outside the list
fun i32 outside(list<i32> source, u64 index) {
  return source[index]
  catch IndexOutOfRangeException { return -1 }
}
Console.log(outside(numbers, 1))
Console.log(outside(numbers, 40))
fun bool badRemove(&list<i32> source) {
  source.removeAt(10)
  return true
  catch IndexOutOfRangeException { return false }
}
Console.log(badRemove(&numbers))

// a list that changes while it is iterated
fun string addWhileLooping(&list<i32> source) {
  for i32 n in source {
    source.add(n)
  }
  return "no exception"
  catch ModifyingIteratedCollectionException { return "changed while iterated" }
}
Console.log(addWhileLooping(&numbers))

// a generic function over a list, and a list of lists
fun T total<T : Numeric>(list<T> items) {
  T sum = 0
  for T item in items {
    sum += item
  }
  return sum
}
list<i32> ints = [1, 2, 3]
Console.log(total(ints))
list<list<i32>> grid = []
grid.add([1, 2])
grid.add([3])
Console.log(grid[0][1])
Console.log(grid.len)
