// for (k, v) in m (spec 6.4), step 3: the entries of a map in key order, the null key first. The loop holds the counter of open iterators:
// a new key or a removal raises ModifyingIteratedCollectionException; changing the value of an existing key is allowed
alias Root as r

map<string, i32> ages = []
ages["bob"] = 30
ages["alice"] = 25
ages["carol"] = 40

for (string name, i32 age) in ages {
  r.Console.log($"{name} is {age}")             // alice is 25, bob is 30, carol is 40
}
i32 total = 0
for (var name, var age) in ages {
  total += age
}
r.Console.log(total)                             // 95
for var (name, age) in ages {
  r.Console.log(name.len + (u64)age)             // 30, 33, 45
}
for (name, age) in ages {
  r.Console.log($"{name}={age}")                 // alice=25, bob=30, carol=40
}

// the value of an existing key can change while the map is iterated
for (string name, i32 age) in ages {
  ages[name] = age + 1
}
r.Console.log(ages)                              // [alice: 26, bob: 31, carol: 41]

// a new key or a removal while iterating raises the exception; the counter is given back after the loop
fun bool addInLoop(map<string, i32> m) {
  for (string key, i32 value) in m {
    m["zed"] = 1
  }
  return true
  catch ModifyingIteratedCollectionException { return false }
}
r.Console.log(addInLoop(ages))                   // false
fun bool removeInLoop(map<string, i32> m) {
  for (string key, i32 value) in m {
    m.removeAt(key)
  }
  return true
  catch ModifyingIteratedCollectionException { return false }
}
r.Console.log(removeInLoop(ages))                // false
ages["dave"] = 50                                // the loops ended: the map can change again
r.Console.log(ages.len)                          // 4

// break, continue and return leave the loop and give the counter back
for (string name, i32 age) in ages {
  if name == "bob" {
    continue
  }
  if name == "carol" {
    break
  }
  r.Console.log(name)                            // alice
}
fun string firstOver(map<string, i32> m, i32 limit) {
  for (string name, i32 age) in m {
    if age > limit {
      return name
    }
  }
  return ""
}
r.Console.log(firstOver(ages, 30))               // bob
ages.removeAt("dave")
r.Console.log(ages.len)                          // 3

// nullable keys: null comes first; native keys in their order
map<i32?, string> slots = []
slots[3] = "three"
slots[null] = "none"
slots[-7] = "minus seven"
for (i32? key, string text) in slots {
  r.Console.log($"{key}: {text}")                // null: none, -7: minus seven, 3: three
}

// an empty map, nested loops over the same map
map<i32, i32> empty = []
for (i32 k, i32 v) in empty {
  r.Console.log("never")
}
map<i32, i32> small = []
small[1] = 10
small[2] = 20
i32 pairs = 0
for (i32 a, i32 x) in small {
  for (i32 b, i32 y) in small {
    pairs += x * y
  }
}
r.Console.log(pairs)                             // 900

// many entries: the loop walks the leaves in order
map<u32, u32> squares = []
u32 i = 500
while i > 0 {
  squares[i] = i * i
  i -= 1
}
u32 previous = 0
bool sorted = true
u64 sum = 0
for (u32 k, u32 v) in squares {
  if k <= previous || v != k * k {
    sorted = false
  }
  previous = k
  sum += (u64)v
}
r.Console.log(sorted)                            // true
r.Console.log(sum)                               // 41791750
