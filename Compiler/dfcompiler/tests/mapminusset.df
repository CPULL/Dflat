// step 5 of the sets plan (spec 6.6): m -= s removes every key of the set s, with its value, from a map or an hmap; set and hset both work
alias Root as r

map<string, i32> ages = ["ann": 30, "bob": 40, "cid": 50, "dan": 60]
set<string> leaving = ["bob", "dan", "nobody"]
ages -= leaving                                      // "nobody" is not a key: nothing happens for it
r.Console.log(ages)                                  // [ann: 30, cid: 50]
r.Console.log(leaving)                               // [bob, dan, nobody]: the set is unchanged

hmap<i32, string> names = [1: "one", 2: "two", 3: "three"]
hset<i32> odd = [1, 3]
names -= odd
r.Console.log(names)                                 // [2: two]
set<i32> two = [2]
names -= two                                         // a set into an hmap: the kinds of the set do not matter
r.Console.log(names.len)                             // 0

hmap<string, i32> scores = ["x": 1, "y": 2]
hset<string> none = []
scores -= none
r.Console.log(scores.len)                            // 2
scores -= "x"                                        // a key is still a key
r.Console.log(scores)                                // [y: 2]

// a field, and the exception when the map is walked (spec 6.4)
class Registry {
  public map<i32, bool> seen = [1: true, 2: true, 3: false]
}
Registry reg = Registry()
set<i32> gone = [2, 3]
reg.seen -= gone
r.Console.log(reg.seen)                              // [1: true]
fun string prune(map<i32, i32> m, set<i32> keys) {
  for (i32 k, i32 v) in m {
    m -= keys
  }
  return "pruned"
  catch ModifyingIteratedCollectionException { return "locked" }
}
map<i32, i32> counts = [1: 1, 2: 2]
set<i32> ones = [1]
r.Console.log(prune(counts, ones))                   // locked
