// Use after a move (spec 12.4): a compile error when the move is certain; a move inside a branch is not; a new value makes the variable usable; x == null is allowed
namespace moves
import Root
class Dog(string name) {
  public string name
} atEnd {
  Console.log($"{name} ends")
}
fun take(->Dog d) { Console.log($"took {d.name}") }
fun f(bool c) {
  Dog d = Dog("A")
  if c { take(->d) } else { Console.log(d.name) }
  Dog e = Dog("B")
  take(->e)
  Console.log($"e is null: {e == null}")
  e = Dog("C")
  Console.log(e.name)
}
f(true)
f(false)
