// Named arguments on library functions
import Root
Console.log("Hello".contains("ELL", caseSensitive: false))
Console.log("Hello".contains(val: "ell"))
Console.log("Hello hello".replace(toFind: "HELLO", replacement: "x", caseSensitive: false))
Console.log("Hello".replace(replacement: "J", toFind: "H"))
Console.log("7".padLeft(4, paddingChar: '0'))
Console.log("7".padRight(totalWidth: 3, paddingChar: '_') + "|")
Console.log("abcdef".substr(len: 2, start: 1))
Console.log("a.b".indexOf('B', caseSensitive: false))
Console.log("a.b".indexOf("B", caseSensitive: false))
Console.log("a;b".split(separator: ";").len)
Console.log(date.parse("x", date(0)))
Console.log(date.parse("5/6/2024", format: "d/M/yyyy"))
