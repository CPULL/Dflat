// Number formatting (spec 8.1, 8.2) and parsing (spec 9) for integers and reals
alias Root as r

i32 n = 12345
i32 neg = -42
r64 pi = 3.14159265
r64 big = 1234.56
r64 half = 2.5
r64 tiny = -0.004

r.Console.Log("--- toStr(format) ---")
r.Console.Log(n.toStr("f0w10"))          // 0000012345
r.Console.Log(n.toStr("w10"))            //      12345
r.Console.Log(n.toStr("w10a<"))          // 12345
r.Console.Log(n.toStr("w10a^") + "|")    //   12345   |
r.Console.Log(neg.toStr("w6"))           //    -42
r.Console.Log(neg.toStr("S+w6f0"))       // 000-42  (the sign next to the digits)
r.Console.Log(neg.toStr("St-w6f0"))      // -00042
r.Console.Log(n.toStr("S+"))             // +12345
r.Console.Log(neg.toStr("S()"))          // (42)
r.Console.Log(n.toStr("bh"))             // 3039
r.Console.Log(n.toStr("bH"))             // 3039
r.Console.Log(255.toStr("bH"))           // FF
r.Console.Log(neg.toStr("bh"))           // ffffffd6
r.Console.Log(n.toStr("bb"))             // 11000000111001
r.Console.Log(n.toStr("bo"))             // 30071
r.Console.Log(n.toStr("g,3"))            // 12,345
r.Console.Log(1234567.toStr("g,3"))      // 1,234,567
r.Console.Log(1234567.toStr("g_3r"))     // 123_456_7
r.Console.Log(n.toStr("D,02"))           // 12345,00
r.Console.Log(pi.toStr("D2"))            // 3.14
r.Console.Log(pi.toStr("D02"))           // 3.14
r.Console.Log(half.toStr("D02"))         // 2.50
r.Console.Log(half.toStr("D2"))          // 2.5
r.Console.Log(half.toStr("D0"))          // 3
r.Console.Log(half.toStr("D0b"))         // 2
r.Console.Log(half.toStr("D0f"))         // 2
r.Console.Log(half.toStr("D0c"))         // 3
r.Console.Log(half.toStr("D0t"))         // 2
r.Console.Log(tiny.toStr("D2"))          // 0
r.Console.Log(tiny.toStr("D2f"))         // -0.01
r.Console.Log(big.toStr("D1"))           // 1234.6
r.Console.Log(big.toStr("g,3D,02"))      // 1,234,56   (the decimal symbol is the comma)
r.Console.Log(big.toStr("g,3D02"))       // 1,234.56
r.Console.Log(big.toStr("D01w12a."))     //
r.Console.Log(big.toStr("e[E+]02D2"))    // 1.23E+03
r.Console.Log(big.toStr("e[e^]02D2"))    // 1.23e^03
r.Console.Log(big.toStr("e[e-]#3D2"))    // 1.23e  3
r.Console.Log(big.toStr("e[x10^]D1"))    // 1.2x10^3
r.Console.Log(big.toStr("e"))            // 1.23456e+3
r.Console.Log(0.00012.toStr("e"))        // 1.2e-4
r.Console.Log(pi.toStr())                // 3.14159265
r.Console.Log(pi.toStr("w12f*a>"))       // **3.14159265
i32? nothing = null
r.Console.Log(nothing.toStr("w6"))       //   null

r.Console.Log("--- interpolation ---")
r.Console.Log($"[{n:g,3}] [{pi:D2}] [{neg:S()}] [{n:bh}] [{big:e}]")
r.Console.Log($"total {n:D,02} and {n:w8a<}|")

r.Console.Log("--- parse ---")
r.Console.Log(i32.parse("123"))              // 123
r.Console.Log(i32.parse("abc", 7))           // 7
r.Console.Log(i32.parse("x-12 and 5", 0))    // -12
r.Console.Log(i32.parse("  42abc"))          // 42
r.Console.Log(i32.parse("12.99"))            // 12
r.Console.Log(i32.parse("1,234"))            // 1
r.Console.Log(u8.parse("-5", 9))             // 0
r.Console.Log(i8.parse("300"))               // 127
r.Console.Log(i64.parse("9223372036854775808")) // 9223372036854775807
r.Console.Log(r64.parse("1.5e3"))            // 1500
r.Console.Log(r64.parse("1,234.5"))          // 1
r.Console.Log(r64.parse("1.234"))            // 1.234
r.Console.Log(r64.parse("NaN"))              // NaN
r.Console.Log(r64.parse("-INF"))             // -∞
r.Console.Log(r32.parse("2.25"))             // 2.25
r.Console.Log(i32.parse("0x3039", 0, "0x{bh}"))     // 12345
r.Console.Log(i32.parse("0x3039", 0, "0x{bH}"))     // 12345
r.Console.Log(i32.parse("ffffffd6", 0, "{bh}"))     // -42
r.Console.Log(i32.parse("-10", 0, "{S}{S()}"))      // -10
r.Console.Log(i32.parse("(10)", 0, "{S}{S()}"))     // -10
r.Console.Log(i32.parse(" 10", 5, "{S}"))           // 5 (strict: nothing skipped)
r.Console.Log(i32.parse("12,345", 0, "{g,3}"))      // 12345
r.Console.Log(r64.parse("12,5", 0.0, "{D,}"))       // 12.5
r.Console.Log(r64.parse("1.23E+03", 0.0, "{e[E+]02D2}")) // 1230
r.Console.Log(i32.parse("$12 USD", 0, "${S} USD"))  // 12
r.Console.Log(i32.parse("0000042", 0, "{f0w7}"))    // 42
r.Console.Log(i32.parse("12", 0, "{bd}x"))          // 0 (suffix does not match)
r.Console.Log(i32.parse(text: "77", format: "{S}")) // 77

// Errors (each one alone): n.toStr("q")  -> unknown option 'q'
//   n.toStr("fx")  -> a letter cannot be the fill character
//   i32.parse("1", 0, "{S}x{S}")  -> static text between placeholders

r.Console.Log("--- silent exceptions of parse ---")
fun rangeCaught() {
  i8 a = i8.parse("999")
  r.Console.Log(a)
  catch OutOfRangeCastException e {
    r.Console.Log("caught range")
  }
}
rangeCaught()
fun overflowCaught() {
  u8 b = u8.parse("-3")
  r.Console.Log(b)
  catch OverflowException e {
    r.Console.Log("caught overflow")
  }
}
overflowCaught()
fun otherCatch() {
  u8 b = u8.parse("-3")
  r.Console.Log("not raised: " + b)    // a catch for another exception does not see it
  catch OutOfRangeCastException e {
    r.Console.Log("wrong")
  }
}
otherCatch()
