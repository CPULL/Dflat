// Classes, phase 4: ownership. Objects end with their owner; the class atEnd runs; ->, is atEnd., weak references
import Root

public class Res {
  public string name = "res"
} atEnd {
  Console.log("  end " + name)
}

public class Holder {
  public string name = "holder"
  public Res inner = Res()
  public Res spare
} atEnd {
  Console.log("  end holder, inner is " + (inner == null ? { "null", "set" }))
}

public class Base {
  public string tag = "base"
} atEnd {
  Console.log("  end Base part")
}
public class Derived : Base {
  public Res part = Res()
} atEnd {
  Console.log("  end Derived part")
}

fun ->Res make(string name) {
  Res made = Res()
  made.name = name
  return made
}

fun Res firstOf(Holder h) { h.inner }

fun use(Res borrowed) {
  Console.log("  using " + borrowed.name)
}

fun take(->Res given) {
  Console.log("  took " + given.name)
}

Console.log("scope end")
{
  Res a = make("a")
  Res b = make("b")
  Res view = a
  Console.log("  inside, view " + view.name)
}
Console.log("after the block")

Console.log("function end")
fun scoped() {
  Res x = make("x")
  use(x)
} atEnd {
  Console.log("  function final cleanup")
}
scoped()

Console.log("explicit release")
Res c = make("c")
c is atEnd.
Console.log("  c is null: " + (c == null))
c is atEnd.

Console.log("move into a variable")
Res d = make("d")
Res e = ->d
Console.log("  d is null: " + (d == null) + ", e is " + e.name)

Console.log("move into a function")
Res f = make("f")
take(->f)
Console.log("  after take, f is null: " + (f == null))

Console.log("new value drops the old one")
Res g = make("g1")
g = make("g2")
Console.log("  g is " + g.name)

Console.log("fields, parent and child")
{
  Holder h = Holder()
  h.spare = make("spare")
  Derived dv = Derived()
  Console.log("  built " + dv.tag)
}

Console.log("move a field out")
{
  Holder h2 = Holder()
  Res taken = ->h2.inner
  Console.log("  taken " + taken.name + ", inner null: " + (h2.inner == null))
}

Console.log("loop")
for i32 i = 0..3 {
  Res item = make("item" + i)
}

Console.log("return and break")
fun ->Res find(i32 n) {
  for i32 i = 0..5 {
    Res candidate = make("cand" + i)
    if i == n { return candidate }
  }
  return null
}
Res found = find(1)
Console.log("  found " + found.name)

Console.log("weak")
@Res strong = make("strong")
%Res weak = %strong
enforce weak {
  Console.log("  alive: " + weak.name)
} else {
  Console.log("  gone")
}
strong is done.
enforce weak {
  Console.log("  alive: " + weak.name)
} else {
  Console.log("  gone")
}

Console.log("exception")
fun fails() {
  Res guard = make("guard")
  throw Exception("boom")
}
fails()
catch Exception ex {
  Console.log("  caught " + ex.message)
}

Console.log("program end")
