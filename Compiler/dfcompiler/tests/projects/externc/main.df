// extern C functions (spec 15.9) with a C file given by csource= in the project
namespace app
import Root

extern fun addr counter_create()
extern fun counter_add(addr c, i32 n)
extern fun i32 counter_total(addr c)
extern fun counter_free(addr c)
extern fun i64 text_bytes(string text)
extern fun u32 bytes_sum(arr<u8> data)
extern fun bytes_fill(arr<u8> data, u8 value)
extern fun r64 halve(r64 x)
extern fun bool is_even(i32 n)
extern fun addr nothing()
extern fun addr greeting()
extern fun addr make_text(i32 n)

addr c = counter_create()
counter_add(c, 40)
counter_add(c, 2)
Console.log(counter_total(c))
Console.log(c != null)
counter_free(c)
Console.log(text_bytes("héllo"))
arr<u8> data = [1, 2, 3, 250]
Console.log(bytes_sum(data))
bytes_fill(data, 7)
Console.log(data[3])
Console.log(halve(5.0))
Console.log(is_even(10))
addr none = nothing()
Console.log(none == null)
addr empty = null
Console.log(empty == none)

// C strings (spec 4.4.4): string(addr) borrows the C text, string(->addr) takes it and frees it
string g = string(greeting())
Console.log($"{g} {g.len}")
addr t = make_text(5000)
string big = string(->t)
Console.log($"{big.len} {t == null}")
big += "!"
Console.log(big.len)
string small = string(->make_text(3))
small += "yz"
Console.log(small)
Console.log(string(nothing()) == "")
string g2 = string(greeting())
g2.clear()
g2 += "abc"
Console.log(g2)
string g3 = string(->make_text(4))
g3 = g3.toUpper()
Console.log(g3)
vec<string> v = []
v.add(string(->make_text(2)))
v.add(string(greeting()))
Console.log(v)
string? noText = string(nothing())
string? someText = string(greeting())
Console.log($"{noText == null} {someText == null} {someText}")
string blank = string(nothing())
Console.log($"[{blank}]")

// C strings with an encoding (spec 4.4.6): UTF8 by default; any other encoding copies the text
extern fun addr wide_greeting()
extern fun addr make_wide(i32 n)
extern fun addr utf32_text()
extern fun addr utf32be_text()
extern fun addr utf16be_text()
extern fun addr latin1_text()
extern fun addr ascii_text()
extern fun addr scratch()
extern fun scratch_change()

string w = string(wide_greeting(), StringEncoding.UTF16)
Console.log($"{w} {w.len}")
addr mw = make_wide(3)
string taken = string(->mw, StringEncoding.UTF16)
Console.log($"{taken} {mw == null}")
Console.log(string(->make_wide(2), encoding: StringEncoding.UTF16))
Console.log(string(utf32_text(), StringEncoding.UTF32))
Console.log(string(utf32be_text(), StringEncoding.UTF32BE))
Console.log(string(utf16be_text(), StringEncoding.UTF16BE))
Console.log(string(latin1_text(), StringEncoding.ISO88591))
Console.log(string(ascii_text(), StringEncoding.ASCII))
Console.log(string(greeting(), StringEncoding.UTF8))
addr sp = scratch()
string borrowed = string(sp)
string copied = string(sp!)
string copied16 = string(wide_greeting()!, StringEncoding.UTF16)
scratch_change()
Console.log($"{borrowed} {copied} {copied16}")
string? noWide = string(nothing(), StringEncoding.UTF16)
string? noCopy = string(nothing()!)
Console.log($"{noWide == null} {noCopy == null}")
copied += "!"
Console.log(copied)
