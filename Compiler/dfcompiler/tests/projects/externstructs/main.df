// structs given to C (spec 11.1.5.6): struct<fixed> and struct<compact>, by value, by address (*S, &*S), as a result
namespace app
import Root

struct<fixed> Vec2 { r32 x, r32 y }
struct<fixed> Fixed { u8 kind, bool ready, r64 weight }
struct<compact> Header { u8 kind, u32 size, bool last }
struct<fixed> Device { u32 id, arr<byte>[8] name, Vec2 at }

extern fun r32 vec_len2(Vec2 v)
extern fun vec_scale(&*Vec2 v, r32 k)
extern fun r32 vec_sum(*Vec2 v)
extern fun Vec2 vec_make(r32 x, r32 y)
extern fun i32 fixed_ready(Fixed f)
extern fun fixed_set(&*Fixed f)
extern fun u32 header_size(Header h)
extern fun u64 sizes()
extern fun u64 offsets()
extern fun u32 device_letters(*Device d)

var v = Vec2(3.0, 4.0)
Console.log(vec_len2(v))
vec_scale(&*v, 2.0)
Console.log(v)
Console.log(vec_sum(*v))
Console.log(vec_make(1.5, 2.5))
var f = Fixed(kind: 1, ready: true)
Console.log(fixed_ready(f))
f.ready = false
Console.log(fixed_ready(f))
fixed_set(&*f)
Console.log($"{f.ready} {f.weight}")
Console.log(header_size(Header(kind: 2, size: 40, last: true)))
Console.log(sizes() == Vec2.sizeof * 1000000 + Fixed.sizeof * 10000 + Header.sizeof * 100 + Device.sizeof)
Console.log(offsets() == f.offset(weight) * 10000 + Header.offset(size) * 100 + Device.offset(at))
Console.log($"{Vec2.sizeof} {Fixed.sizeof} {Header.sizeof} {Device.sizeof}")
var d = Device(id: 9, name: [68b, 102b, 108b, 97b, 116b, 0b, 0b, 0b])
Console.log(device_letters(*d))
