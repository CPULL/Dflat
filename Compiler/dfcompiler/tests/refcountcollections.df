namespace refcountcollections
import Root

public class Dog(string name, i32 age) {
  public string name
  public i32 age
} atEnd {
  Console.log("  end " + name)
}

Console.log("1 arr<@Dog>")
@Dog rex = Dog("rex", 5)
arr<@Dog> pack = [@rex, Dog("bo", 2), Dog("max", 9)]
Console.log($"{pack[0].name} {pack[1].name} {rex.usersCount}")
pack[1] = Dog("new", 1)
arr<@Dog>[2] empty
Console.log(empty[0] == null)
empty[1] = @rex
Console.log($"{empty[1].name} {rex.usersCount}")
for Dog d in pack {
  Console.log("loop " + d.name)
}
@Dog first = pack[0]
Console.log(first.usersCount)

Console.log("2 sort")
pack.sort((Dog a, Dog b) { a.age - b.age })
Console.log($"{pack[0].name} {pack[1].name} {pack[2].name}")
var team = vec<@Dog>()
team.add(Dog("c", 3))
team.add(Dog("a", 1))
team.add(@rex)
team.sort((Dog a, Dog b) { a.age - b.age })
Console.log($"{team[0].name} {team[1].name} {team[2].name}")

Console.log("3 resize, fillAtCapacity, fill")
team.resize(5, @rex)
Console.log($"{team.len} {team[4].name} {rex.usersCount}")
team.resize(2, null)
Console.log($"{team.len} {rex.usersCount}")
empty.fill(@rex)
Console.log(rex.usersCount)

Console.log("4 iterator")
var it = team.getIterator()
var got = it.next()
Console.log($"{got.value.name} {got.isValid}")

Console.log("5 view")
var middle = team[0..2]
Console.log(middle[1].name)
for Dog v in middle {
  Console.log("view " + v.name)
}
Console.log("end")
