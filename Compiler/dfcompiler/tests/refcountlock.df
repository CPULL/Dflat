// Read/write counted objects (spec 7.2, 12.7): &@T and &%T take the lock of their object in enforce (timeout from the enforce or the
// default of @T() timeout); a busy lock goes to lockfail; a write through a &@T without the lock raises WritingOnRefCountWithoutLockingException
import Root
public class Player(string name) {
  public string name
  public i32 score
} atEnd {
  Console.log("  end " + name)
}
fun addScore(&@Player p, i32 n) {
  enforce p {
    p.score += n
  }
}
fun nested(&@Player p) {
  enforce p {
    Console.log("  outer holds the lock")
    enforce p timeout 50 {
      Console.log("  never")
    }
    lockfail on p { Console.log("  inner: lockfail") }
  }
}
fun unlocked(&@Player p) {
  p.score = 5
}
fun tryUnlocked(&@Player p) {
  unlocked(&@p)
  Console.log("  never printed")
  catch WritingOnRefCountWithoutLockingException {
    Console.log("  caught: write without the lock")
  }
}
fun run() {
  &@Player player = @Player("ann") timeout 100
  enforce player {
    player.score = 10
    player.score++
  }
  atEnd { Console.log($"  score {player.score}") }
  addScore(&@player, 5)
  Console.log($"  after add {player.score}")
  nested(&@player)
  &%Player watcher = %player
  enforce watcher timeout 0 {
    watcher.name = "bob"
  }
  Console.log($"  name {player.name}")
  @Player reader = player
  Console.log($"  reader {reader.name}")
  tryUnlocked(&@player)
  enforce player {
    unlocked(&@player)
    Console.log($"  locked write {player.score}")
  }
  Console.log("  end of main")
}
run()
