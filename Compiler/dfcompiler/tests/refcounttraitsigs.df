// Counted parameters and results in trait functions and overrides (spec 12.7): dispatched like any other function
namespace refcounttraitsigs
import Root
class Dog(string name) {
  public string name
} atEnd {
  Console.log($"{name} ends")
}
trait Keeper {
  public fun keep(@Dog d)
  public fun @Dog favourite()
  public fun bump(&@i32 n)
  public fun ->string describe(@Dog d) { $"a keeper of {d.name}" }
}
class Kennel : Keeper {
  @Dog kept
  replace fun keep(@Dog d) { kept = d }
  replace fun @Dog favourite() { kept }
  replace fun bump(&@i32 n) { enforce n { n += 1 } }
}
class Base {
  public fun @i32 score() { 1 }
  public fun take(@Dog d) { Console.log($"base takes {d.name}") }
}
class Child : Base {
  replace fun @i32 score() { 2 }
  replace fun take(@Dog d) { Console.log($"child takes {d.name}, users {d.usersCount}") }
}
fun f() {
  @Dog rex = Dog("Rex")
  Kennel k = Kennel()
  &Keeper keeper = k                       // a read/write borrow: keep changes the kennel
  keeper.keep(@rex)
  Console.log($"users {rex.usersCount}")
  @Dog fav = keeper.favourite()
  Console.log($"{fav.name} users {rex.usersCount}")
  &@i32 n = 1
  keeper.bump(&@n)
  Console.log($"n {n} {keeper.describe(@rex)}")
  Base b = Child()
  @i32 s = b.score()
  b.take(@rex)
  Console.log($"score {s}, users {rex.usersCount}")
}
f()
