// a field has its own text (spec 4): k.label = a copies it, a change of a is not seen through the field
import Root

class Kennel {
  public string label
  public string other
}

fun fill(&Kennel k, i32 n) {
  string t = "box " + n.toStr()
  k.label = t                      // t ends with the function, k.label keeps its text
  t += "!"
}

fun copyParam(&Kennel k, string s) {
  k.other = s                      // the field has its own text
}

fun rebind(&Kennel k) {
  string a = "first " + 1.toStr()
  k.label = a
  Console.log(k.label)
  a = "second " + 2.toStr()        // a gets a new string; the field keeps the first
  Console.log($"{a} / {k.label}")
}

fun inner(&Kennel k) {
  string a = "outer " + 3.toStr()
  {
    Kennel local = Kennel()
    local.label = a                // local ends first
    a += "?"
    Console.log(local.label)
  }
  Console.log(a)
}

Kennel k = Kennel()
string a = "top " + 0.toStr()
k.label = a
a += " changed"
Console.log(k.label)             // top 0
fill(&k, 5)
Console.log(k.label)             // box 5
string given = "given " + 9.toStr()
copyParam(&k, given)
given += "!"
Console.log(k.other)             // given 9
rebind(&k)
inner(&k)
k.label = "literal"
Console.log(k.label)
