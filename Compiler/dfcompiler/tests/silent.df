// Silent standard exceptions of the date and time constructors (spec 3.3, 15.4)
alias Root as r

// no catch: the value falls back to null and nothing is raised
fun nothingCaught() {
  date a = date("not a date")
  r.Console.log(a == null)
  time none = time(-1)
  r.Console.log(none == null)
  time big = (time)90000000
  r.Console.log(big == null)
}

// a plain catch does not handle a silent exception
fun plainCatch() {
  date b = date("bad")
  r.Console.log(b == null)
  catch ex {
    r.Console.log("wrong: catch ex must not see a silent exception")
  }
}

// a catch for its own type does (it covers the statements above it)
fun ownType() {
  date c = date("still bad")
  r.Console.log("not printed when raised")
  catch InvalidDateTimeFormatException ex {
    r.Console.log("caught: " + ex.Message)
  }
}

fun otherType() {
  time late = time(90000000)
  r.Console.log("not printed either")
  catch OutOfRangeCastException ex {
    r.Console.log("caught: " + ex.Message)
  }
}

// the other silent exception is not handled by a catch for a different one
fun wrongType() {
  date d = date("bad again")
  r.Console.log(d == null)
  catch OutOfRangeCastException {
    r.Console.log("wrong: different exception")
  }
}

fun catchAll() {
  time t = (time)(-3)
  r.Console.log("skipped")
  catch all {
    r.Console.log("catch all sees it")
  }
}

fun valid() {
  date fine = date("2024-02-02")
  r.Console.log(fine)
  catch InvalidDateTimeFormatException {
    r.Console.log("wrong: valid date")
  }
}

fun time safe(string text) {
  time t = time(text)
  catch InvalidDateTimeFormatException {
    return time("00:00")
  }
  return t
}

nothingCaught()
plainCatch()
ownType()
otherType()
wrongType()
catchAll()
valid()
r.Console.log(safe("08:15"))
r.Console.log(safe("garbage"))
