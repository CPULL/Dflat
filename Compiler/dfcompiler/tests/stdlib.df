// Standard library: Math, Random, Time, Console
import Root

// Math on r64
Console.log(Math.sqrt(16.0))
Console.log(Math.pow(2.0, 10.0))
Console.log(Math.fmod(7.5, 2.0))
Console.log(Math.log(8.0, 2.0))
Console.log(Math.sign(-3.5))
Console.log(Math.round(2.5))
Console.log(Math.min(4.0, 2.0, 3.0))
Console.log(Math.max(4.0, 2.0, 9.5))
Console.log(Math.hypot(3.0, 4.0))
Console.log(Math.hypot(2.0, 3.0, 6.0))
Console.log(Math.clamp(15.0, 0.0, 10.0))
Console.log(Math.lerp(0.0, 10.0, 0.25))
Console.log(Math.inverseLerp(0.0, 10.0, 2.5))
Console.log(Math.min(1.0, Math.sqrt(-1.0)))
r32 half = 0.5f
Console.log(Math32.sqrt(half * 8f))

// Math on integers
i32 neg = -7
Console.log(Math.abs(neg))
Console.log(Math.sign(neg))
Console.log(Math.min(neg, 3))
Console.log(Math.max(1, 2, 3))
u8 small = 200b
Console.log(Math.clamp(small, 10b, 100b))
Console.log(Math.PI)

// Random: same seed, same sequence
Random.seed(42ul)
i64 first = Random.int(1, 1000)
i64 second = Random.int(1, 1000)
Random.seed(42ul)
Console.log(first == Random.int(1, 1000))
Console.log(second == Random.int(1, 1000))
bool inRange = true
for u8 i = 0..200 {
  i64 v = Random.int(-3, 3)
  r64 f = Random.real()
  r64 g = Random.realRange(5.0, 6.0)
  if v < -3 || v > 3 || f < 0.0 || f > 1.0 || g < 5.0 || g >= 6.0 { inRange = false }
}
Console.log(inRange)
Console.log(Random.int(9, 9))

// Time
date now = Time.now()
date none = null
Console.log(now > none)
Console.log(none == null)
Console.log(now != null)
Console.log($"none is {none}")
clock c1 = Time.clock()
clock c2 = Time.clock()
Console.log(c2 >= c1)
Console.log(c1 != null)
lapse elapsed = c2 - c1
Console.log(elapsed.toStr().len > 0)
