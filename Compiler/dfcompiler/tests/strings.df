// String functions (spec 4.2)
import Root

string text = "  Hello, World  "
Console.log("[" + text.trim() + "]")
Console.log("[" + text.trimLeft() + "]")
Console.log("[" + text.trimRight() + "]")
Console.log("[" + "xxabcxx".trim("x") + "]")
Console.log("[" + "xxabcxx".trimLeft("x") + "]")
Console.log("[" + "xxabcxx".trimRight("x") + "]")
Console.log("[" + "\t\u{00A0}tab\n".trim() + "]")

Console.log("Hello".substr(1, 3))
Console.log("Hello".substr(3, 100))
Console.log("Hello".substr(9, 2) == "")
Console.log("héllo wörld".substr(1, 4))

Console.log("a-b-c".replace("-", "+"))
Console.log("Hello hello HELLO".replace("hello", "x", false))
Console.log("Hello hello HELLO".replace("hello", "x"))
Console.log("abc".replace("", "x"))
Console.log("aaa".replace("a", ""))

Console.log("hello".indexOf("l"))
Console.log("hello".indexOf("z"))
Console.log("hello".indexOf('o'))
Console.log("HELLO".indexOf("ell", false))
Console.log("HELLO".indexOf("ell"))
Console.log("héllo".indexOf("l"))
Console.log("hello".lastIndexOf("l"))
Console.log("hello".lastIndexOf('h'))
Console.log("hello".lastIndexOf("zz"))

Console.log("hello".contains("ell"))
Console.log("hello".contains("ELL"))
Console.log("hello".contains("ELL", false))
Console.log("hello".startsWith("he"))
Console.log("hello".startsWith("HE", false))
Console.log("hello".startsWith("lo"))
Console.log("hello".endsWith("lo"))
Console.log("hello".endsWith("LO", false))
Console.log("hello".endsWith("he"))
Console.log("hello".endsWith("hello world"))

Console.log("Straße ÀÉÎ ñ".toUpper())
Console.log("ÀÉÎ STRASSE Ñ Σ".toLower())

Console.log("7".padLeft(3, '0'))
Console.log("7".padLeft(3) + "|")
Console.log("7".padRight(3) + "|")
Console.log("é".padRight(3, '*'))
Console.log("long".padLeft(2))

// chained calls
Console.log("  MiXed  ".trim().toLower().padLeft(8, '.'))

// split
arr<string> parts = "a,b,,c".split(",")
Console.log(parts.len)
Console.log(parts)
Console.log("one".split(",").len)
Console.log("".split(",").len)
Console.log("a--b".split("--"))
for string part in parts { Console.print("<" + part + ">") }
Console.log("")

// index of a character, chars not bytes
string word = "añb"
Console.log(word[1])
Console.log(word[2] == 'b')

// bytes of a C string
arr<byte> bytes = "hé".toCStr()
Console.log(bytes.len)
Console.log(bytes)
Console.log("A".toCStr(StringEncoding.UTF16))
Console.log("A".toCStr(String.StringEncoding.UTF32BE))
Console.log("é€".toCStr(StringEncoding.ASCII))
Console.log("é€".toCStr(StringEncoding.ISO88591))
