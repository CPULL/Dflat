namespace structtuples
alias Root as r

struct Vec2 { r32 x, r32 y }
struct Flip { r32 b, r32 a }
struct Size { i32 w, i32 h }
struct Named { string name, i32 age }
struct Grid { arr<u8>[3] cells, i32 tag }

class Sprite {
  public pos { r32 x, r32 y }
}

fun i32, i32 bounds() { return Size(3, 4) }

fun (string n, i32 a) person() { Named(name: "ann", age: 30) }

fun Vec2 make() { Vec2(5.0, 6.0) }

var s = Sprite()
s.pos = Vec2(12.5, 5.0)
r.Console.log($"{s.pos.x} {s.pos.y}")
var f = Flip(1.0, 2.0)
s.pos = f
r.Console.log($"{s.pos.x} {s.pos.y}")
s.pos = make()
r.Console.log($"{s.pos.x} {s.pos.y}")
(r32 x, r32 y) t = Vec2(7.0, 8.0)
r.Console.log(t)
r32 a, r32 b = f
r.Console.log($"{a} {b}")
i32 w, i32 h = bounds()
r.Console.log($"{w} {h}")
var p = person()
r.Console.log(p)
Named n = Named(name: "bob", age: 4)
string who, i32 age = n
n.name = "changed"
r.Console.log($"{who} {age} {n.name}")
r.Console.log(Vec2(1.0, 2.0).hash == Vec2(1.0, 2.0).hash)
r.Console.log(Vec2(1.0, 2.0).hash == Vec2(2.0, 1.0).hash)
r.Console.log(n.hash == Named(name: "changed", age: 4).hash)
var g = Grid(cells: [1b, 2b, 3b])
var g2 = g
g2.cells[2] = 9b
r.Console.log(g.hash == g2.hash)
