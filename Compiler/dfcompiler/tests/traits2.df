// Traits: the same member in two traits, qualified names, trait constructors and construction order
alias Root as r

trait TraitA {
  string tag = "A"
  fun string Who() { "A's who" }
  fun string OnlyA() { "only A" }
}
trait TraitB {
  string tag = "B"
  fun string Who() { "B's who" }
}
trait Counted {
  i32 made
  Counted() { made = 100 }
}

public class Both : TraitA, TraitB {
  override fun string Who() { "both: " + TraitA.Who() + " / " + TraitB.Who() + " / " + TraitA.tag + TraitB.tag }
}

public class Plain : TraitA, TraitB {
  public i32 x
}

public class Order : Counted {
  public i32 value = made + 1
}

Both b = Both()
r.Console.log(b.Who())
r.Console.log(b.TraitA.Who())
r.Console.log(b.TraitB.Who())
r.Console.log(b.TraitA.tag)
r.Console.log(b.TraitB.tag)
b.TraitB.tag = "changed"
r.Console.log(b.TraitB.tag)
r.Console.log(b.TraitA.tag)
r.Console.log(b.OnlyA())

Plain p = Plain()
r.Console.log(p.TraitA.Who())
r.Console.log(p.TraitB.Who())
TraitA viewA = p
r.Console.log(viewA.Who())
r.Console.log(viewA.tag)

// the trait constructor runs before the body of the class
Order o = Order()
r.Console.log(o.value)
r.Console.log(o.made)
