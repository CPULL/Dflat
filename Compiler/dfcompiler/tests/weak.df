// Weak references (spec 12.7): only on counted objects, made with %x; fields, header parameters, parameters, variables; enforce gives a
// temporary usage; the holder does not keep the object alive
namespace weak
alias Root as r

class Context {
  public i32 id = 7
} atEnd {
  r.Console.log($"context {id} ends")
}

class Handle(%Context context) {
  public %Context other
  public fun i32 read() {
    enforce context { return context.id }
    return -1
  }
  public fun link(%Context c) { other = c }
  public fun bool hasOther() {
    enforce other { return true }
    return false
  }
}

fun string probe(%Context c) {
  enforce c { return "alive" }
  return "gone"
}

@Context ctx = Context()
var h = Handle(%ctx)
r.Console.log(h.read())
r.Console.log(h.hasOther())
h.link(%ctx)
r.Console.log(h.hasOther())
r.Console.log($"weak references {ctx.weakrefsCount}")
%Context w
r.Console.log(probe(%ctx))
w = %ctx
enforce w {
  r.Console.log($"{w.id}, users inside enforce {ctx.usersCount}")
} else {
  r.Console.log("none")
}
r.Console.log($"users after enforce {ctx.usersCount}")
%Context copy = w                           // a weak reference copied into another
r.Console.log($"weak references {ctx.weakrefsCount}")
enforce copy { r.Console.log("copy ok") } else { r.Console.log("copy none") }
ctx is done.                                // the last user: the object ends, the weak references see it gone
r.Console.log(h.read())
r.Console.log(h.hasOther())
enforce w { r.Console.log(w.id) } else { r.Console.log("w gone") }
r.Console.log(probe(%copy))
copy is done.
r.Console.log(h)

// a weak field does not end with its holder
Context plain8 = Context()
plain8.id = 8                                // set before it is counted: a @T is read-only (spec 12.7)
@Context ctx2 = @plain8
var h2 = Handle(%ctx2)
h2 is atEnd.
r.Console.log($"{ctx2.id}, weak references {ctx2.weakrefsCount}")
r.Console.log(probe(%ctx2))

// the temporary usage of enforce keeps the object alive while the block runs, and is released on every way out
fun i32 early(%Context c) {
  enforce c {
    if c.id == 8 { return 1 }
    return 2
  }
  return 0
}
r.Console.log(early(%ctx2))
r.Console.log($"users after early {ctx2.usersCount}")
