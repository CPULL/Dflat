<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dfcompile</AssemblyName>
    <RootNamespace>dfcompile</RootNamespace>
  </PropertyGroup>

  <!-- shared with dfparse: the two project folders must be side by side -->
  <ItemGroup>
    <Compile Include="..\dfparser\Lexer.cs" Link="Shared\Lexer.cs" />
    <Compile Include="..\dfparser\Parser.cs" Link="Shared\Parser.cs" />
    <Compile Include="..\dfparser\Node.cs" Link="Shared\Node.cs" />
  </ItemGroup>

</Project>
