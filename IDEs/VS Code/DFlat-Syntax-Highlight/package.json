
{
  "name": "dflat-syntax",
  "displayName": "DFlat Syntax Highlight",
  "description": "Syntax highlighting for the D♭ (Dflat) programming language",
  "version": "0.0.3",
  "publisher": "local",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dflat",
        "aliases": [
          "Dflat",
          "dflat",
          "D♭"
        ],
        "extensions": [
          ".df"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dflat",
        "scopeName": "source.df",
        "path": "./syntaxes/dflat.tmLanguage.json"
      }
    ]
  }
}

