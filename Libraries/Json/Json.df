import Root
import Root.io

Generic JsonType { JsonNull, JsonNum, string, bool, JsonArray, JsonObject, JsonComment }

class JSON {
  public static fun JsonNode parse(string json, JsonSerializationOptions options) { 
    JsonParser parser = JsonParser(json, 0, options)
    return parser.parseDocument()
  }
  public static fun string serialize(JsonNode node, JsonSerializationOptions options) {
    JsonWriter writer = JsonWriter(options)
	string res = writer.writeNode(node, 0)
    return ->res
  }
}

// Object classes

class JsonNull {
	// Nothing is required here, it is a null
}

class JsonNum {
	public JsonNum(r64 v) {
		isFloat = true
		floatValue = v
	}
	public JsonNum(i64 v) {
		isFloat = false
		intValue = v
	}
	public bool isFloat
	public r64 floatValue
	public i64 intValue
	unrestricted fun string write() {
		if isFloat {
			return floatValue.toStr("D#")
		} 
		else {
			return intValue.toStr()
		}
	}
}

class JsonArray {
  public vec<JsonType> arr = []
}

class JsonObject {
  public vec<JsonNode> obj = []
}

class JsonComment(string comment) {
  public string comment
}

// Main Json node class

class JsonNode(string? key, JsonType value) {
  public string? key
  public JsonType value
  
  
  public fun bool isNull() { 
    value is ? {
			JsonNull: true,
		  default: false 
		} 
  }
  public fun bool isNumber() { 
    value is ? {
	  	JsonNum: true,
			default: false 
		} 
  }
  public fun bool isString() { 
    value is ? {
			string: true,
			default: false 
		} 
  }
  public fun bool isBool() { 
    value is ? {
			bool: true,
			default: false 
		} 
  }
  public fun bool isObject() { 
    value is ? {
			JsonObject: true,
			default: false 
		} 
  }
  public fun bool isArray() { 
    value is ? {
			JsonArray: true,
			default: false 
		} 
  }
  public fun bool isComment() { 
    value is ? {
			JsonComment: true,
			default: false 
		} 
  }
  
  
  public fun JsonNode get(string targetKey) {
    if value is JsonObject jo {
      for child in jo.obj {
        if child.key == targetKey {
          return child
        }
      }
    }
    return null
  }
  
  public fun bool hasKey(string targetKey) {
    get(targetKey) != null
  }
  
  public fun bool set(string targetKey, JsonType newValue) {
    if value is JsonObject jo {
      for child in jo.obj {
        if child.key == targetKey {
          child.value = newValue
          return true
        }
      }
      jo.obj.add(JsonNode(targetKey, newValue))
      return true
    }
    return false
  }
  
  public fun bool remove(string targetKey) {
    if value is JsonObject jo {
	  int pos = -1
      for i = 0..jo.obj.len {
        if jo.obj[i].key == targetKey {
		  pos = (int)i
		  break
        }
      }
	  if pos !=-1 {
	    jo.obj.removeAt((uns)pos)
        return true
      }
    }
    return false
  }  
}

bitfield32 JsonSerializationOptions { PrettyPrint:0, AllowCommentsInSerialization:1, NoStrict:2, AllowCommentsInParsing:3 }

// a parsing error: where it happened and the text that was parsed
class JsonParsingException(uns position, string1k text) : Exception {
  public uns position
  public string1k text
  public JsonParsingException(uns pos, string json, string msg) : JsonParsingException("", pos, json) {
    string part = pos > 16 ? { json.substr(pos-16, 32), json.substr(0, 32) }
    replace message = $"JSON Error: {msg} at position {pos}: {part}\n{json}"
  }
}

class JsonWriter(JsonSerializationOptions options) {
  bool pretty = options.isSet(JsonSerializationOptions.PrettyPrint)
  bool allowComments = options.isSet(JsonSerializationOptions.AllowCommentsInSerialization)

  public fun string writeNode(JsonNode node, uns depth) {
    string text = ""
    if (node.key != null) {
      text = writeString(node.key) + ":"
      if (pretty) {
        text = text + " "
      }
    }
    string val = writeValue(node.value, depth)
    return ->text + val
  }


  fun bool isComment(JsonNode j) {
    if j.value is JsonComment {
	  return true
	}
    return false
  }

  fun string writeObject(JsonObject source, uns depth) {
    uns lastMember = 0
    uns index = 0
    while (index < source.obj.len) {
		if source.obj[index].value is JsonComment {
		}
		else {
		  lastMember = index
		}
      index++
    }
    string body = ""
    bool wroteAny = false
    index = 0
    while (index < source.obj.len) {
      JsonNode item = source.obj[index]
      if source.obj[index].value is JsonComment jc {
        if (allowComments) {
          body = body + lineBreak(depth + 1) + writeComment(jc)
          wroteAny = true
        }
      } else {
        body = body + lineBreak(depth + 1) + writeNode(item, depth + 1)
        if (index < lastMember) {
          body = body + ","
        }
        wroteAny = true
      }
      index++
    }
    if (!wroteAny) {
      return "{}"
    }
    return "{" + body + lineBreak(depth) + "}"
  }
  
  fun string writeValue(JsonType value, uns depth) {
    return value is ? {
      JsonObject: writeObject(value, depth),
      JsonArray: writeArray(value, depth),
      JsonComment: writeComment(value),
      string: writeString(value),
      bool: writeBool(value),
      JsonNum: writeNumber(value),
			JsonNull: "null",
		  default: "null"
    }
  }
  
  fun string writeArray(JsonArray source, uns depth) {
    uns lastItem = 0
    uns index = 0
    while (index < source.arr.len) {
	  if source.arr[index] is JsonComment jc {
	  }
	  else {
        lastItem = index
      }
      index++
    }
    string body = ""
    bool wroteAny = false
    index = 0
    while (index < source.arr.len) {
      JsonType item = source.arr[index]
	  if source.arr[index] is JsonComment jc {
        if (allowComments) {
          body = body + lineBreak(depth + 1) + writeComment(jc)
          wroteAny = true
        }
      } else {
        body = body + lineBreak(depth + 1) + writeValue(item, depth + 1)
        if (index < lastItem) {
          body = body + ","
        }
        wroteAny = true
      }
      index++
    }
    if (!wroteAny) {
      return "[]"
    }
    return "[" + body + lineBreak(depth) + "]"
  }

  fun string writeComment(JsonComment source) {
    return "/*" + source.comment + "*/"
  }

  fun string writeString(string raw) {
    string result = "\""
    uns index = 0
    while (index < raw.len) {
      char current = raw[index]
      if (current == '"') {
        result = result + "\\\""
      } else if (current == '\\') {
        result = result + "\\\\"
      } else if (current == '\n') {
        result = result + "\\n"
      } else if (current == '\r') {
        result = result + "\\r"
      } else if (current == '\t') {
        result = result + "\\t"
      } else if (current < ' ') {
        result = result + "\\u00" + hexDigit((uns)current / 16) + hexDigit((uns)current % 16)
      } else {
        result = result + current
      }
      index++
    }
    return result + "\""
  }

  fun string writeBool(bool flag) {
    if (flag) {
      return "true"
    }
    return "false"
  }

  fun string writeNumber(JsonNum number) {
    return number.write()
  }

  fun string lineBreak(uns depth) {
    if (!pretty) {
      return ""
    }
    string text = "\n"
    for uns level = 0..depth {
      text += "  "
    }
    return ->text
  }

  fun char hexDigit(uns value) {
    if (value < 10) {
      return (char)((uns)'0' + value)
    }
    return (char)((uns)'A' + value - 10)
  }

}

class JsonParser(string text, uns position, JsonSerializationOptions options) {
  bool lenient = options.isSet(JsonSerializationOptions.NoStrict)
  bool parseComments = options.isSet(JsonSerializationOptions.AllowCommentsInParsing)

  public fun JsonNode parseDocument() {
    skipTrivia()
    JsonNode root = JsonNode(null, parseValue())
    skipTrivia()
    if (position < text.len) {
      throw JsonParsingException(position, text, "Unexpected content after the JSON value")
    }
    return root
  }

  fun JsonType parseValue() {
    if (position >= text.len) {
      throw JsonParsingException(position, text, "Unexpected end of input")
    }
    char current = text[position]
    if (current == '{') {
      return parseObject()
    }
    if (current == '[') {
      return parseArray()
    }
    if (current == '"' || (lenient && current == '\'')) {
      return parseString()
    }
    if (current == '-' || isDigit(current)) {
      return parseNumber()
    }
    if (matchWord("true")) {
      return true
    }
    if (matchWord("false")) {
      return false
    }
    if (matchWord("null")) {
      return JsonNull()
    }
    throw JsonParsingException(position, text, "Unexpected character '" + current + "'")
  }

  fun JsonObject parseObject() {
    JsonObject result = JsonObject()
    position++
    bool memberAllowed = true
    bool closeAllowed = true
    bool commaAllowed = false
    while (true) {
      skipWhitespace()
      if (position >= text.len) {
        throw JsonParsingException(position, text, "Unterminated object")
      }
      char current = text[position]
      if (atComment()) {
        if (parseComments) {
          result.obj.add(JsonNode(null, readComment()))
        } else {
          readComment()
        }
      } else if (current == '}') {
        if (!closeAllowed && !lenient) {
          throw JsonParsingException(position, text, "Trailing comma is not allowed")
        }
        position++
        return result
      } else if (current == ',') {
        if (!commaAllowed) {
          throw JsonParsingException(position, text, "Unexpected comma")
        }
        position++
        memberAllowed = true
        closeAllowed = false
        commaAllowed = false
      } else if (memberAllowed) {
        string memberKey = ""
        if (current == '"' || (lenient && current == '\'')) {
          memberKey = parseString()
        } else if (lenient) {
          memberKey = parseBareKey()
        } else {
          throw JsonParsingException(position, text, "Expected a string key")
        }
        skipTrivia()
        if (position >= text.len || text[position] != ':') {
          throw JsonParsingException(position, text, "Expected ':' after the key")
        }
        position++
        skipTrivia()
		var jn = JsonNode(memberKey, parseValue())
        result.obj.add(->jn)
        memberAllowed = false
        closeAllowed = true
        commaAllowed = true
      } else {
        throw JsonParsingException(position, text, "Expected ',' or '}'")
      }
    }
	return result
  }

  fun JsonArray parseArray() {
    JsonArray result = JsonArray()
    position++
    bool itemAllowed = true
    bool closeAllowed = true
    bool commaAllowed = false
    while (true) {
      skipWhitespace()
      if (position >= text.len) {
        throw JsonParsingException(position, text, "Unterminated array")
      }
      char current = text[position]
      if (atComment()) {
        if (parseComments) {
          result.arr.add(readComment())
        } else {
          readComment()
        }
      } else if (current == ']') {
        if (!closeAllowed && !lenient) {
          throw JsonParsingException(position, text, "Trailing comma is not allowed")
        }
        position++
        return result
      } else if (current == ',') {
        if (!commaAllowed) {
          throw JsonParsingException(position, text, "Unexpected comma")
        }
        position++
        itemAllowed = true
        closeAllowed = false
        commaAllowed = false
      } else if (itemAllowed) {
        result.arr.add(parseValue())
        itemAllowed = false
        closeAllowed = true
        commaAllowed = true
      } else {
        throw JsonParsingException(position, text, "Expected ',' or ']'")
      }
    }
	return result
  }

  fun string parseBareKey() {
    uns keyStart = position
    while (position < text.len && text[position] != ':' && !isWhitespace(text[position])) {
      char current = text[position]
      if (current == ',' || current == '\'' || current == '"') {
        throw JsonParsingException(position, text, "Invalid character '" + current + "' in an unquoted key")
      }
      position++
    }
    if (position == keyStart) {
      throw JsonParsingException(position, text, "Expected a key")
    }
    return text.substr(keyStart, position - keyStart)
  }

  fun string parseString() {
    char quote = text[position]
    position++
    string result = ""
    while (true) {
      if (position >= text.len) {
        throw JsonParsingException(position, text, "Unterminated string")
      }
      char current = text[position]
      if (current == quote) {
        position++
        return ->result
      }
      if (current < ' ') {
        throw JsonParsingException(position, text, "Control character inside a string")
      }
      if (current != '\\') {
        result = result + current
        position++
        continue
      }
      position++
      if (position >= text.len) {
        throw JsonParsingException(position, text, "Unterminated escape sequence")
      }
      char escaped = text[position]
      if (escaped == '"') {
        result = result + '"'
      } else if (escaped == '\\') {
        result = result + '\\'
      } else if (escaped == '/') {
        result = result + '/'
      } else if (lenient && escaped == '\'') {
        result = result + '\''
      } else if (escaped == 'b') {
        result = result + (char)8u
      } else if (escaped == 'f') {
        result = result + (char)12u
      } else if (escaped == 'n') {
        result = result + '\n'
      } else if (escaped == 'r') {
        result = result + '\r'
      } else if (escaped == 't') {
        result = result + '\t'
      } else if (escaped == 'u') {
        if (position + 4 >= text.len) {
          throw JsonParsingException(position, text, "Incomplete \\u escape")
        }
        uns codeUnit = 0
        for uns digitIndex = 1..=4 {
          codeUnit = codeUnit * 16u + hexValue(text[position + digitIndex])
        }
        position += 4
        // a high surrogate followed by \u and a low surrogate: one character (U+10000 and above)
        if codeUnit >= 0xD800u && codeUnit <= 0xDBFFu && position + 6 < text.len && text[position + 1] == '\\' && text[position + 2] == 'u' {
          uns low = 0
          for uns lowIndex = 3..=6 {
            low = low * 16u + hexValue(text[position + lowIndex])
          }
          if low >= 0xDC00u && low <= 0xDFFFu {
            codeUnit = 0x10000u + (codeUnit - 0xD800u) * 0x400u + (low - 0xDC00u)
            position += 6
          }
        }
        result = result + (char)codeUnit
      } else {
        throw JsonParsingException(position, text, "Invalid escape sequence '\\" + escaped + "'")
      }
      position++
    }
	return result
  }

  fun JsonNum parseNumber() {
    uns start = position
    if (text[position] == '-') {
      position++
    }
    if (position >= text.len || !isDigit(text[position])) {
      throw JsonParsingException(position, text, "Invalid number")
    }
    if (text[position] == '0') {
      position++
    } else {
      while (position < text.len && isDigit(text[position])) {
        position++
      }
    }
    if (position < text.len && text[position] == '.') {
      position++
      if (position >= text.len || !isDigit(text[position])) {
        throw JsonParsingException(position, text, "Invalid number: digits expected after '.'")
      }
      while (position < text.len && isDigit(text[position])) {
        position++
      }
    }
    if (position < text.len && (text[position] == 'e' || text[position] == 'E')) {
      position++
      if (position < text.len && (text[position] == '+' || text[position] == '-')) {
        position++
      }
      if (position >= text.len || !isDigit(text[position])) {
        throw JsonParsingException(position, text, "Invalid number: digits expected in the exponent")
      }
      while (position < text.len && isDigit(text[position])) {
        position++
      }
    }
		string number = text.substr(start, position - start)
		if number.indexOf('.') != -1 || number.indexOf('e') != -1 || number.indexOf('E') != -1 {
			return JsonNum(r64.parse(number))
		}
		else {
    	return JsonNum(i64.parse(number))
		}
  }

  fun JsonComment readComment() {
    if (!lenient && !parseComments) {
      throw JsonParsingException(position, text, "Comments are not allowed")
    }
    string content = ""
    position += 2
    uns contentStart = position
    if (text[position - 1] == '/') {
      while (position < text.len && text[position] != '\n') {
        position++
      }
      content = text.substr(contentStart, position - contentStart)
	  content.trimRight("\r")
    } else {
	  bool closed = false
      while (position + 1 < text.len) {
        if (text[position] == '*' && text[position + 1] == '/') {
          closed = true
          break
        }
        position++
      }
      if (!closed) {
        throw JsonParsingException(position, text, "Unterminated comment")
      }
      content = text.substr(contentStart, position - contentStart)
      position += 2
    }
    return JsonComment(content)
  }

  fun bool atComment() {
    return position + 1 < text.len && text[position] == '/' && (text[position + 1] == '/' || text[position + 1] == '*')
  }

  fun skipWhitespace() {
    while (position < text.len && isWhitespace(text[position])) {
      position++
    }
  }

  fun skipTrivia() {
    skipWhitespace()
    while (atComment()) {
      readComment()
      skipWhitespace()
    }
  }

  fun bool matchWord(string word) {
    if (position + word.len > text.len) {
      return false
    }
    if (text.substr(position, word.len) != word) {
      return false
    }
    if (position + word.len < text.len && isWordChar(text[position + word.len])) {
      return false
    }
    position += word.len
    return true
  }

  fun bool isWhitespace(char value) {
    return value == ' ' || value == '\t' || value == '\n' || value == '\r'
  }

  fun bool isDigit(char value) {
    return value >= '0' && value <= '9'
  }

  fun bool isWordChar(char value) {
    return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || isDigit(value) || value == '_'
  }

  fun uns hexValue(char value) {
    if (value >= '0' && value <= '9') {
      return (uns)value - (uns)'0'
    }
    if (value >= 'a' && value <= 'f') {
      return (uns)value - (uns)'a' + 10
    }
    if (value >= 'A' && value <= 'F') {
      return (uns)value - (uns)'A' + 10
    }
    throw JsonParsingException(position, text, "Invalid hex digit '" + value + "'")
  }

}


fun main(arr<string> params) {
  string json = ""
  if params.len < 2{
    Console.log("Usage: json <file.json> [-pp] [-pc] [-sc] [-ns]\n-pp enables prettyprint\n-pc reads comments in json\n-sc writes comments when serializing\n-ns allows no strict json")
	return
  }

  File jf = File(params[1])
  json = jf.readAllText()
  JsonSerializationOptions opts = JsonSerializationOptions.NONE
  for i = 2..params.len {
    if params[i]=="--pp" || params[i]=="-pp" || params[i]=="pp" then opts.set(JsonSerializationOptions.PrettyPrint)
    if params[i]=="--pc" || params[i]=="-pc" || params[i]=="pc" then opts.set(JsonSerializationOptions.AllowCommentsInParsing)
    if params[i]=="--sc" || params[i]=="-sc" || params[i]=="sc" then opts.set(JsonSerializationOptions.AllowCommentsInSerialization)
    if params[i]=="--ns" || params[i]=="-ns" || params[i]=="ns" then opts.set(JsonSerializationOptions.NoStrict)
  }
  var test = JSON.parse(json, opts)
  Console.log(JSON.serialize(test, opts))
  
  catch Exception ex {
    Console.log("Error: " + ex.message)
	Console.log("Original:\n" + json)
  }
}
