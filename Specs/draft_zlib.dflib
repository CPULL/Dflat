// zlib - compression library
Name: zlib
Namespace: std.compress.zlib
Description: zlib compression (deflate), crc32 and adler32
Version: 1.3.1
Convention: cdecl
LibName, linux-*, dynamic: libz.so
LibName, win-*, dynamic: zlib1.lib, zlib1.dll

// C unsigned long (uLong): 4 bytes on win-x32, win-x64, linux-x32, 8 bytes on linux-x64, linux-arm64
alias u32 as ULong
linux-x64, linux-arm64 {
  alias u64 as ULong
}

// result codes
enum i32 ZResult { Ok: 0, StreamEnd: 1, NeedDict: 2, Errno: -1, StreamError: -2,
                   DataError: -3, MemError: -4, BufError: -5, VersionError: -6 }

// compression levels: 0 (none) to 9 (best), or Z_DEFAULT_COMPRESSION
const i32 Z_NO_COMPRESSION = 0
const i32 Z_BEST_SPEED = 1
const i32 Z_BEST_COMPRESSION = 9
const i32 Z_DEFAULT_COMPRESSION = -1

// get the zlib version (a static text: borrowed)
native *char zlibVersion()
fun string v version() -> v = string(zlibVersion())

// the largest size compress can produce from sourceLen bytes
native ULong compressBound(ULong sourceLen)
fun uns n bound(uns len) -> n = compressBound((ULong)len)

// compress a buffer with the default level
native i32 compress(&*u8 dest, &*ULong destLen, *u8 source, ULong sourceLen)
fun ZResult res, uns written compress(&arr<byte> dest, arr<byte> src) -> {
    ULong len = (ULong)dest.len                      // in: the size of the buffer
    res = (ZResult)compress(dest, &len, src, (ULong)src.len)
    written = len                                    // out: the bytes zlib wrote
}

// compress a buffer with a level
native i32 compress2(&*u8 dest, &*ULong destLen, *u8 source, ULong sourceLen, i32 level)
fun ZResult res, uns written compress(&arr<byte> dest, arr<byte> src, i32 level) -> {
    ULong len = (ULong)dest.len
    res = (ZResult)compress2(dest, &len, src, (ULong)src.len, level)
    written = len
}

// decompress a buffer
native i32 uncompress(&*u8 dest, &*ULong destLen, *u8 source, ULong sourceLen)
fun ZResult res, uns written uncompress(&arr<byte> dest, arr<byte> src) -> {
    ULong len = (ULong)dest.len
    res = (ZResult)uncompress(dest, &len, src, (ULong)src.len)
    written = len
}

// checksums; len is a C unsigned int (4 bytes everywhere); the value fits in 32 bits
native ULong crc32(ULong crc, *u8 buf, u32 len)
fun u32 c crc32(u32 crc, arr<byte> buf) -> c = (u32)crc32(crc, buf, (u32)buf.len)

native ULong adler32(ULong adler, *u8 buf, u32 len)
fun u32 a adler32(u32 adler, arr<byte> buf) -> a = (u32)adler32(adler, buf, (u32)buf.len)
