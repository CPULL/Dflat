<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
		<ApplicationIcon>..\GFX\dflat-compiler.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dfcompiler</AssemblyName>
    <RootNamespace>dfcompiler</RootNamespace>
    <Version>0.0.7-alpha</Version>
  </PropertyGroup>

  <!-- shared with dfparser: the two project folders must be side by side -->
  <ItemGroup>
    <Compile Include="..\dfparser\Lexer.cs" Link="Shared\Lexer.cs" />
    <Compile Include="..\dfparser\Parser.cs" Link="Shared\Parser.cs" />
    <Compile Include="..\dfparser\Node.cs" Link="Shared\Node.cs" />
  </ItemGroup>

</Project>
