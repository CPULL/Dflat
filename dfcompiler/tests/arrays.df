// Arrays: the part of the collections the library needs (spec 6.7)
alias Root as r

arr<i32> numbers = [3, 1, 2]
r.Console.Log(numbers)
r.Console.Log(numbers.len)
r.Console.Log(numbers[0] + numbers[2])
numbers[1] = 10
numbers[2] += 5
r.Console.Log(numbers)

arr<string> names = ["ann", "bob"]
r.Console.Log(names[1].ToUpper())
var buffer = arr<i32>[4]
r.Console.Log(buffer)
buffer.fill(7)
r.Console.Log(buffer)
buffer.clear()
r.Console.Log(buffer)

arr<r64> reals = [1, 2.5]
r.Console.Log(reals)
arr floats = [1.5, 2.5]
r.Console.Log(floats[1])
arr words = ["x", "y", "z"]
r.Console.Log(words)

arr<i32> list = [5, 6, 7, 8]
r.Console.Log(list.has(7))
r.Console.Log(list.has(9))
r.Console.Log(list.indexOf(8))
r.Console.Log(list.indexOf(1) == 0xFFFFFFFFFFFFFFFFu)
list.reverse()
r.Console.Log(list)

i32 total = 0
for i32 item in list { total += item }
r.Console.Log(total)
for var name in names { r.Console.Print(name + ";") }
r.Console.Log("")
for char ch in "hé!" { r.Console.Print("[" + ch + "]") }
r.Console.Log("")

// jagged
arr<arr<i32>> rows = [[1, 2], [3, 4, 5]]
r.Console.Log(rows[1][2])
r.Console.Log(rows.len)
r.Console.Log(rows)

// null and identity
arr<i32> none = null
arr<i32> same = numbers
r.Console.Log(none == null)
r.Console.Log(numbers == null)
r.Console.Log(numbers == same)
arr<i32> copyOfValues = [3, 10, 7]
r.Console.Log(numbers == copyOfValues)
arr<i32> empty = []
r.Console.Log(empty.len)
r.Console.Log(empty == null)

// out of range
fun i32 at(arr<i32> data, i32 position) {
  return data[position]
}
r.Console.Log(at(numbers, 2))
i32 caught = 0
at(numbers, 3)
catch IndexOutOfRangeException ex {
  r.Console.Log("caught: " + ex.Message)
  caught += 1
}
numbers[7] = 1
catch IndexOutOfRangeException {
  caught += 1
}
i32 negative = -1
numbers[negative]
catch IndexOutOfRangeException {
  caught += 1
}
"abc"[5]
catch IndexOutOfRangeException {
  caught += 1
}
r.Console.Log(caught)

// shuffle is deterministic with a seed
r.Random.Seed(7ul)
arr<i32> deck = [1, 2, 3, 4, 5, 6, 7, 8]
r.Random.Shuffle(deck)
i32 sum = 0
for i32 card in deck { sum += card }
r.Console.Log(sum)
r.Console.Log(deck.len)
r.Random.Seed(7ul)
arr<i32> deck2 = [1, 2, 3, 4, 5, 6, 7, 8]
r.Random.Shuffle(deck2)
bool equalOrder = true
for i32 k = 0..8 {
  if deck[k] != deck2[k] { equalOrder = false }
}
r.Console.Log(equalOrder)
string letters = "abcdef"
r.Random.Shuffle(letters)
r.Console.Log(letters.len)
r.Console.Log(letters.Contains("a") && letters.Contains("f"))
