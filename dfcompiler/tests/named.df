// Named arguments on library functions
alias Root as r
r.Console.Log("Hello".Contains("ELL", caseSensitive: false))
r.Console.Log("Hello".Contains(val: "ell"))
r.Console.Log("Hello hello".Replace(toFind: "HELLO", replacement: "x", caseSensitive: false))
r.Console.Log("Hello".Replace(replacement: "J", toFind: "H"))
r.Console.Log("7".PadLeft(4, paddingChar: '0'))
r.Console.Log("7".PadRight(totalWidth: 3, paddingChar: '_') + "|")
r.Console.Log("abcdef".Substr(len: 2, start: 1))
r.Console.Log("a.b".IndexOf('B', caseSensitive: false))
r.Console.Log("a.b".IndexOf("B", caseSensitive: false))
r.Console.Log("a;b".Split(separator: ";").len)
r.Console.Log(date.parse("x", date(0)))
r.Console.Log(date.parse("5/6/2024", format: "d/M/yyyy"))
