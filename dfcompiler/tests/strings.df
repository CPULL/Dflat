// String functions (spec 4.2)
alias Root as r

string text = "  Hello, World  "
r.Console.Log("[" + text.Trim() + "]")
r.Console.Log("[" + text.TrimLeft() + "]")
r.Console.Log("[" + text.TrimRight() + "]")
r.Console.Log("[" + "xxabcxx".Trim("x") + "]")
r.Console.Log("[" + "xxabcxx".TrimLeft("x") + "]")
r.Console.Log("[" + "xxabcxx".TrimRight("x") + "]")
r.Console.Log("[" + "\t\u{00A0}tab\n".Trim() + "]")

r.Console.Log("Hello".Substr(1, 3))
r.Console.Log("Hello".Substr(3, 100))
r.Console.Log("Hello".Substr(9, 2) == "")
r.Console.Log("héllo wörld".Substr(1, 4))

r.Console.Log("a-b-c".Replace("-", "+"))
r.Console.Log("Hello hello HELLO".Replace("hello", "x", false))
r.Console.Log("Hello hello HELLO".Replace("hello", "x"))
r.Console.Log("abc".Replace("", "x"))
r.Console.Log("aaa".Replace("a", ""))

r.Console.Log("hello".IndexOf("l"))
r.Console.Log("hello".IndexOf("z"))
r.Console.Log("hello".IndexOf('o'))
r.Console.Log("HELLO".IndexOf("ell", false))
r.Console.Log("HELLO".IndexOf("ell"))
r.Console.Log("héllo".IndexOf("l"))
r.Console.Log("hello".LastIndexOf("l"))
r.Console.Log("hello".LastIndexOf('h'))
r.Console.Log("hello".LastIndexOf("zz"))

r.Console.Log("hello".Contains("ell"))
r.Console.Log("hello".Contains("ELL"))
r.Console.Log("hello".Contains("ELL", false))
r.Console.Log("hello".StartsWith("he"))
r.Console.Log("hello".StartsWith("HE", false))
r.Console.Log("hello".StartsWith("lo"))
r.Console.Log("hello".EndsWith("lo"))
r.Console.Log("hello".EndsWith("LO", false))
r.Console.Log("hello".EndsWith("he"))
r.Console.Log("hello".EndsWith("hello world"))

r.Console.Log("Straße ÀÉÎ ñ".ToUpper())
r.Console.Log("ÀÉÎ STRASSE Ñ Σ".ToLower())

r.Console.Log("7".PadLeft(3, '0'))
r.Console.Log("7".PadLeft(3) + "|")
r.Console.Log("7".PadRight(3) + "|")
r.Console.Log("é".PadRight(3, '*'))
r.Console.Log("long".PadLeft(2))

// chained calls
r.Console.Log("  MiXed  ".Trim().ToLower().PadLeft(8, '.'))

// split
arr<string> parts = "a,b,,c".Split(",")
r.Console.Log(parts.len)
r.Console.Log(parts)
r.Console.Log("one".Split(",").len)
r.Console.Log("".Split(",").len)
r.Console.Log("a--b".Split("--"))
for string part in parts { r.Console.Print("<" + part + ">") }
r.Console.Log("")

// index of a character, chars not bytes
string word = "añb"
r.Console.Log(word[1])
r.Console.Log(word[2] == 'b')

// bytes of a C string
arr<byte> bytes = "hé".ToCStr()
r.Console.Log(bytes.len)
r.Console.Log(bytes)
r.Console.Log("A".ToCStr(StringEncoding.UTF16))
r.Console.Log("A".ToCStr(String.StringEncoding.UTF32BE))
r.Console.Log("é€".ToCStr(StringEncoding.ASCII))
r.Console.Log("é€".ToCStr(StringEncoding.ISO88591))
