// Dflat sample v0.0.2: exercises the syntax dfparser understands

namespace demo
import stdrnd
alias r Root
alias octet u8

// ------------------------------------------------ literals
i32 a = 10
i32 b = 0; char c = 'c'; string what = "what"
u64 big = 0x00000000DEADBEEF
u32 mask = 0b1111_0000u
i64 million = 1_000_000l
u64 huge = 42ul
u8 small = 200b
i16 shortOne = 300s
r64 half = 0.5
r32 third = 0.33f
r64 avogadro = 6.022e23
char smile = '\u{1F600}'
char brace = '\#{123}'
const i32 limit = 100
i8? maybe = null
i8 abyte = maybe ?? 0

// ------------------------------------------------ collections
list<i32> nums = [1, 2, 3, 4, 5]
vec<4, i16> v4 = [1, 2, 3, 4]
vec words = ["a", "b", "c"]
map ages = { john: 30, mary: 25 }
map<i32, string> names = { 1: "one", 2: "two", -1: "minus one" }
hmap<string, list<i32>> groups = { odd: [1, 3], even: [2, 4] }
list<i32> head = nums[..2]
list<i32> tail = nums[1..]
list<i32> mid = nums[1..=3]
nums.RemoveAt(3..)

// ------------------------------------------------ functions
fun u64 fib(u64 n) {
  if n < 2 then return n
  return fib(n - 1) + fib(n - 2)
}

fun i32, string getUser() {
  return 1, "john"
}

fun (i32 val, string name) getPair() {
  return (1, "name")
}

fun hello(string name = "john doe", i32 age) {
  r.Console.Log($"Hello {name}, age {age:f0w3}")
}

fun take(->Item gift, Item borrowed, &i32 counter, Item copied!, &Item readOnly!) {
  counter++
}

fun callBack(i32 val, i32(string, u8) cb, fun(i32) done) {
  done(cb("a", 1))
}

i32 id, string uname = getUser()
_, string onlyName = getUser()
(i32, r128, string) triple = (1, 2.5, "x")

// ------------------------------------------------ traits and classes
trait Named {
  string name

  Named(string n) {
    name = n
  }

  fun string Label()

  fun string Hello() {
    return $"Hi {Label()}"
  }
}

trait Shape : Named {
  fun r64 Area()
}

public class Circle(r64 radius) : root.Class, Shape {
  public Circle() : Circle(1.0), Named("circle")

  public override fun r64 Area() {
    return r.Math.Pi * radius * radius
  }

  public override fun string Label() { "circle" }
}

public class Px(i32 a, i32 b) {
  u64 c = [u64]a << 32 | [u64]b

  public Px() : Px(0, 0)
  public Px(u64 a, char b) : Px([i32]a, (i32)a) {
    c = [u64]b
  }

  public fun u64 GetVal() { c }
}

public enum Color Colors {
  Red: Color(1, 0, 0), Green: Color(0, 1, 0), Blue: Color(0, 0, 1)
  , fun Colors Closest(Color col) {
    return Colors.Red
  }
}

enum Status { Active, Inactive, Pending: 10 }

// ------------------------------------------------ ownership
Item first = Item(1)
Item sameObject = first
Item owner = ->first
Item weakRef _= owner
Item counted = Item(2).asRefCount
Item shared = Item(3).asSharedRefCount
Item copied = owner!
Item cloned = owner.clone()
if counted.isRC then r.Console.Log("counted")
enforce weakRef {
  weakRef.Use()
} else {
  r.Console.Log("gone")
}
items.add(->owner)

// ------------------------------------------------ lambdas
i32 top = 5
fun bool isBig = (i32 x; top!) { x > top }
nums.Sort((l, m) { l < m })
u64 total = nums
  .Filter((n; top, ->pool, _cache) { n > top })
  .len

// ------------------------------------------------ control flow
for i32 i = 0..10 step i += 2 {
  if i == 4 then continue
  if i == 8 then break
}
for i32 n in nums {
  r.Console.Log($"{n:w5a>}")
}
for key in ages.keys {
  r.Console.Log(key)
}
for i32 x = 0..3 {
  for i32 y = 0..3 {
    if x * y == 4 then break Found
  }
  #Found#
}

switch a {
  1: r.Console.Log("one"), 2: jump 1
  3, 4, 5: { b = 1; b++ }
  default: jump #done#
}

bool res = a ? { 1: true, 2: true, default: false }
string yn = res ? { "yes", "no" }
r.Console.Log($"{a ? { 1: "one", default: "many" }} and \{braces\}")
r.Console.Log($"today {r.Now():dd/MM/yyyy HH:mm a<20}")

{
  a--
} while a > 0

i32 x = 1
i32 y = 2
x, y = y, x

// ------------------------------------------------ types, casts, operators
dyn Shape s = Circle(2.0)
if s is Circle cc {
  r.Console.Log($"r = {cc.radius:D,02}")
}
if s is null then r.Console.Log("none")
i16 big16 = 257
i8 sat = (i8)big16
i8 low = [i8]big16
r32 bits = [r32]a
i32 inv = _a
bool z = (a & 0xFF) == 0
a >>= 2

// ------------------------------------------------ random
Rnd rnd = Rnd([u64]r.Now())
i32 dice = rnd.Int(1, 7)
rnd.Shuffle(nums)

// ------------------------------------------------ errors
atEnd {
  r.Console.Log("bye")
}

#done#
i32 q = 10 / b
catch DivisionByZeroException ex {
  r.Console.LogError(ex.message)
}
catch ex {
  throw Exception("unexpected")
}
if b < 0 then throw Panic(3)
return 0
